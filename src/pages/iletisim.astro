---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Starfield from '../components/Starfield.astro';

const siteUrl = 'https://makineceviri.net';
const pageUrl = `${siteUrl}/iletisim`;
const pageTitle = 'İletişim — Makine Çeviri';
const pageDesc = 'Makine Çeviri topluluğuyla iletişime geçin. Discord, GitHub ve LinkedIn üzerinden bize ulaşın.';
---

<Layout title={pageTitle} description={pageDesc} canonical={pageUrl}>
  <Starfield />
  <Navbar />

  <div class="contact">
    <div class="contact__hero">
      <h1 class="contact__title">İletişim</h1>
      <p class="contact__subtitle">Soru, öneri veya katkı — her zaman burdayız.</p>
    </div>

    <div class="contact__body">
      <!-- Left: Form -->
      <div class="contact__form-wrap glass-card">
        <h2 class="contact__form-heading">Bize yazın</h2>
        <form class="contact__form" id="contact-form">
          <div class="contact__field">
            <label for="c-name">Adınız</label>
            <input type="text" id="c-name" name="name" required autocomplete="name" />
          </div>
          <div class="contact__field">
            <label for="c-email">E-posta</label>
            <input type="email" id="c-email" name="email" required autocomplete="email" />
          </div>
          <div class="contact__field">
            <label for="c-subject">Konu</label>
            <input type="text" id="c-subject" name="subject" required />
          </div>
          <div class="contact__field">
            <label for="c-message">Mesaj</label>
            <textarea id="c-message" name="message" rows="5" required></textarea>
          </div>
          <button type="submit" class="contact__submit">Mesaj Gönder</button>
        </form>
      </div>

      <!-- Right: Info + Socials -->
      <div class="contact__info">
        <div class="contact__info-card glass-card">
          <h2 class="contact__info-heading">Doğrudan ulaşın</h2>
          <p class="contact__info-text">Form yerine doğrudan e-posta göndermek isterseniz:</p>
          <a href="mailto:iletisim@makineceviri.net" class="contact__email">iletisim@makineceviri.net</a>
        </div>

        <div class="contact__socials glass-card">
          <h2 class="contact__info-heading">Sosyal medya</h2>
          <div class="contact__social-list">
            <a href="https://discord.com/invite/QDezpy4QtV" target="_blank" rel="noopener noreferrer" class="contact__social-link">
              <div class="contact__social-icon contact__social-icon--discord">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419-.0189 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1568 2.4189Z"/></svg>
              </div>
              <div class="contact__social-info">
                <span class="contact__social-name">Discord</span>
                <span class="contact__social-desc">Toplulukla sohbet et, yardım al</span>
              </div>
              <span class="contact__social-arrow">&rarr;</span>
            </a>

            <a href="https://github.com/MakineCeviri" target="_blank" rel="noopener noreferrer" class="contact__social-link">
              <div class="contact__social-icon contact__social-icon--github">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
              </div>
              <div class="contact__social-info">
                <span class="contact__social-name">GitHub</span>
                <span class="contact__social-desc">Kaynak kodu, hata bildirimi</span>
              </div>
              <span class="contact__social-arrow">&rarr;</span>
            </a>

            <a href="https://www.linkedin.com/company/makineceviri" target="_blank" rel="noopener noreferrer" class="contact__social-link">
              <div class="contact__social-icon contact__social-icon--linkedin">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </div>
              <div class="contact__social-info">
                <span class="contact__social-name">LinkedIn</span>
                <span class="contact__social-desc">Profesyonel güncellemeler</span>
              </div>
              <span class="contact__social-arrow">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = form?.querySelector('.contact__submit') as HTMLButtonElement;

  if (form && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);

      submitBtn.disabled = true;
      submitBtn.textContent = 'Gönderiliyor…';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: fd.get('name'),
            email: fd.get('email'),
            subject: fd.get('subject'),
            message: fd.get('message'),
          }),
        });

        const data = await res.json();

        if (data.ok) {
          submitBtn.textContent = 'Gönderildi!';
          submitBtn.style.background = '#4ecdc4';
          form.reset();
          setTimeout(() => {
            submitBtn.textContent = 'Mesaj Gönder';
            submitBtn.style.background = '';
            submitBtn.disabled = false;
          }, 3000);
        } else {
          submitBtn.textContent = data.error || 'Bir hata oluştu';
          submitBtn.style.background = '#e74c3c';
          setTimeout(() => {
            submitBtn.textContent = 'Mesaj Gönder';
            submitBtn.style.background = '';
            submitBtn.disabled = false;
          }, 3000);
        }
      } catch {
        submitBtn.textContent = 'Bağlantı hatası';
        submitBtn.style.background = '#e74c3c';
        setTimeout(() => {
          submitBtn.textContent = 'Mesaj Gönder';
          submitBtn.style.background = '';
          submitBtn.disabled = false;
        }, 3000);
      }
    });
  }
</script>
