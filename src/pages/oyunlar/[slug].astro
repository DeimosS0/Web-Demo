---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

interface GamePackage {
  name: string;
  v: string;
  sizeBytes: number;
  size: number;
  dataUrl: string;
  checksum: string;
  dirName: string;
}

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return d.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' });
}

function formatSize(bytes: number): string {
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + ' KB';
  return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}

export async function getStaticPaths() {
  function slugify(name: string): string {
    const trMap: Record<string, string> = {
      'ç': 'c', 'Ç': 'c', 'ş': 's', 'Ş': 's', 'ğ': 'g', 'Ğ': 'g',
      'ü': 'u', 'Ü': 'u', 'ö': 'o', 'Ö': 'o', 'ı': 'i', 'İ': 'i',
    };
    return name
      .toLowerCase()
      .split('')
      .map(c => trMap[c] || c)
      .join('')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');
  }
  const catalog = (await import('../../data/index.json')).default as {
    packages: Record<string, GamePackage>;
  };
  const slugMap = new Map<string, string>();
  const paths: { params: { slug: string }; props: { appId: string } & GamePackage }[] = [];
  
  for (const [appId, pkg] of Object.entries(catalog.packages)) {
    let slug = slugify(pkg.name);
    if (slugMap.has(slug)) slug = `${slug}-${appId}`;
    slugMap.set(slug, appId);
    paths.push({ params: { slug }, props: { appId, ...pkg } });
  }
  return paths;
}

const { appId, name, v, sizeBytes, size } = Astro.props;
const slug = Astro.params.slug;

let genres: string[] = [];
try {
  const genreData = (await import('../../data/genres.json')).default as Record<string, string[]>;
  genres = genreData[appId] || [];
} catch { /* genres.json not yet generated */ }

const siteUrl = 'https://makineceviri.net';
const pageUrl = `${siteUrl}/oyunlar/${slug}`;
const steamUrl = `https://store.steampowered.com/app/${appId}`;

// Steam header oranlarında tam oturacak resimler
const coverImg = `https://cdn.makineceviri.net/assets/images/${appId}.png`;
const heroImg = `https://cdn.akamai.steamstatic.com/steam/apps/${appId}/library_hero.jpg`;

const pageTitle = `${name} Türkçe Yama — Makine Çeviri`;
const pageDesc = `${name} oyunu için Makine Çeviri topluluğu tarafından hazırlanan Türkçe yama.`;

const isDubbed = ["1245620", "266840"].includes(appId);
---

<Layout title={pageTitle} description={pageDesc} canonical={pageUrl} ogImage={coverImg}>
  <Navbar showSearch={false} />

  <main class="store-detail-page">
    
    <div class="hero-banner-wrapper">
      <img src={heroImg} alt="" class="hero-bg-img" id="parallax-bg" onerror={`this.onerror=null;this.src="${coverImg}"`} />
      <div class="hero-mask-gradient"></div>
    </div>

    <div class="page-content-wrapper">
      
      <div class="top-nav-row ai-fade-up">
        <a href="/oyunlar" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
          Geri Dön
        </a>
      </div>

      <div class="game-showcase-grid">
        
        <div class="showcase-left ai-fade-up delay-1">
          <div class="cover-art-container tilt-effect">
            <img src={coverImg} alt={name} class="poster-img" onerror={`this.onerror=null;this.src="https://cdn.akamai.steamstatic.com/steam/apps/${appId}/header.jpg"`} />
            <div class="glass-glare"></div>
          </div>
        </div>

        <div class="showcase-right ai-fade-up delay-2">
          
          <div class="tag-flex">
            {isDubbed && <span class="accent-tag dublaj">TR Dublaj Mevcut</span>}
            {genres.map(g => <span class="accent-tag">{g}</span>)}
          </div>

          <h1 class="game-display-title">{name}</h1>
          
          <div class="developer-row">
            <span>Geliştirici: <strong class="brand-text">Makine Çeviri</strong></span>
            <span class="dot-sep">•</span>
            <span>Güncelleme: <strong>{formatDate(v)}</strong></span>
          </div>

          <div class="action-bar">
            <button id="download-trigger-btn" class="download-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Hemen İndir
            </button>
            
            <a href={steamUrl} target="_blank" rel="noopener noreferrer" class="steam-link-btn">
              Steam'de Gör
            </a>
          </div>

          <p class="game-about-text">
            Makine Çeviri tarafından hazırlanan dil paketi ile <strong>{name}</strong> oyununu ana dilinizde, orijinal dosyalarınız bozulmadan ve performans kaybı yaşamadan oynayın.
          </p>

          <div class="details-bento">
            <div class="d-box">
              <span class="d-label">Dosya Boyutu</span>
              <span class="d-value">{formatSize(sizeBytes)}</span>
            </div>
            <div class="d-box">
              <span class="d-label">Desteklenen Platform</span>
              <span class="d-value">PC (Windows)</span>
            </div>
            <div class="d-box">
              <span class="d-label">Çeviri Türü</span>
              <span class="d-value">Metin {isDubbed ? '& Ses' : ''}</span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </main>

  <div id="download-modal" class="modal-backdrop hidden">
    <div class="modal-container">
      <button id="close-modal-btn" class="close-btn" aria-label="Kapat">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      
      <div class="modal-content">
        <div class="spinner-ring"></div>
        <h3 class="modal-title">İndirme Başlatılıyor...</h3>
        <p class="modal-desc">
          <strong>{name}</strong> yaması için gerekli olan MakineAI istemcisi indiriliyor. Kurulumu tamamladıktan sonra oyununuzu tek tıkla Türkçe yapabilirsiniz.
        </p>
        <a href="https://github.com/makineceviri/makine-istemci/releases/latest/download/MakineAI-Setup.exe" class="manual-dl-link">
          Otomatik başlamadıysa buraya tıklayın.
        </a>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .store-detail-page { position: relative; min-height: 100vh; background: #09090b; color: #fafafa; padding-bottom: 120px; }

  .hero-banner-wrapper { position: absolute; top: 0; left: 0; width: 100%; height: 85vh; overflow: hidden; z-index: 0; pointer-events: none; }
  .hero-bg-img { width: 100%; height: 120%; object-fit: cover; object-position: center 20%; opacity: 0.7; filter: blur(4px) saturate(1.1); will-change: transform; }
  .hero-mask-gradient { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(9,9,11,0.1) 0%, rgba(9,9,11,0.8) 60%, #09090b 100%); }

  .page-content-wrapper { position: relative; z-index: 2; max-width: 1200px; margin: 0 auto; padding: 160px 24px 0; }

  .top-nav-row { margin-bottom: 2rem; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; font-size: 0.95rem; font-weight: 500; color: #a1a1aa; text-decoration: none; padding: 8px 16px; border-radius: 100px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(10px); transition: all 0.3s; }
  .back-link svg { width: 18px; height: 18px; transition: transform 0.3s; }
  .back-link:hover { color: #fff; background: rgba(255,255,255,0.1); }
  .back-link:hover svg { transform: translateX(-4px); }

  /* ANA GRİD: Sol kolon resim kırpılmasın diye genişletildi (420px) */
  .game-showcase-grid { display: grid; grid-template-columns: 420px 1fr; gap: 4rem; align-items: start; margin-bottom: 6rem; }

  .showcase-left { perspective: 1000px; }
  
  /* KESİLME SORUNU BURADA ÇÖZÜLDÜ: aspect-ratio 16/9 yapıldı */
  .cover-art-container { 
    position: relative; width: 100%; aspect-ratio: 16/9; border-radius: 16px; overflow: hidden; 
    background: #18181b; box-shadow: 0 20px 50px rgba(0,0,0,0.6); 
    border: 1px solid rgba(255,255,255,0.1); transform-style: preserve-3d; transition: transform 0.2s ease-out; 
  }
  .poster-img { width: 100%; height: 100%; object-fit: cover; }
  .glass-glare { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 50%); pointer-events: none; }

  .showcase-right { display: flex; flex-direction: column; justify-content: center; }

  .tag-flex { display: flex; gap: 8px; margin-bottom: 1rem; flex-wrap: wrap; }
  .accent-tag { background: rgba(255,255,255,0.08); color: #e4e4e7; font-size: 0.85rem; font-weight: 500; padding: 4px 12px; border-radius: 100px; backdrop-filter: blur(5px); }
  .accent-tag.dublaj { background: #10b981; color: #000; font-weight: 700; }

  .game-display-title { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; line-height: 1.1; margin-bottom: 0.5rem; letter-spacing: -0.02em; text-shadow: 0 4px 20px rgba(0,0,0,0.6); }
  
  .developer-row { display: flex; align-items: center; gap: 12px; font-size: 0.95rem; color: #a1a1aa; margin-bottom: 2.5rem; flex-wrap: wrap; }
  .developer-row strong { color: #fff; font-weight: 500; }
  .brand-text { color: #4ecdc4 !important; font-weight: 600 !important; }
  .dot-sep { color: #3f3f46; }

  .action-bar { display: flex; gap: 1rem; align-items: center; margin-bottom: 3rem; }
  
  .download-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    background: #fafafa; color: #000; font-size: 1.05rem; font-weight: 700;
    padding: 16px 36px; border-radius: 100px; border: none; cursor: pointer; outline: none;
    transition: transform 0.2s, background 0.2s, box-shadow 0.2s; box-shadow: 0 10px 20px rgba(255,255,255,0.1);
  }
  .download-btn svg { width: 20px; height: 20px; }
  .download-btn:hover { transform: translateY(-3px); background: #fff; box-shadow: 0 15px 30px rgba(255,255,255,0.2); }

  .steam-link-btn { display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.08); color: #fff; font-size: 1rem; font-weight: 600; padding: 16px 28px; border-radius: 100px; text-decoration: none; transition: background 0.2s, transform 0.2s; backdrop-filter: blur(10px); }
  .steam-link-btn:hover { background: rgba(255,255,255,0.15); transform: translateY(-3px); }

  .game-about-text { font-size: 1.1rem; color: #d4d4d8; line-height: 1.6; max-width: 800px; margin-bottom: 3rem; font-weight: 400; }
  .game-about-text strong { color: #fff; font-weight: 600; }

  .details-bento { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; background: rgba(24, 24, 27, 0.4); border: 1px solid rgba(255,255,255,0.05); padding: 2rem; border-radius: 20px; backdrop-filter: blur(20px); }
  .d-box { display: flex; flex-direction: column; gap: 4px; }
  .d-label { font-size: 0.85rem; color: #a1a1aa; font-weight: 500; }
  .d-value { font-size: 1.1rem; color: #fff; font-weight: 600; }

  /* Modal Stilleri */
  .modal-backdrop { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(15px); z-index: 9999; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s ease; padding: 20px; }
  .modal-backdrop.show { opacity: 1; pointer-events: auto; }
  
  .modal-container { position: relative; background: #18181b; border: 1px solid rgba(255,255,255,0.1); border-radius: 24px; width: 100%; max-width: 450px; padding: 3rem 2rem; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.5); transform: scale(0.95); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
  .modal-backdrop.show .modal-container { transform: scale(1); }

  .close-btn { position: absolute; top: 16px; right: 16px; background: transparent; border: none; color: #a1a1aa; cursor: pointer; padding: 8px; border-radius: 50%; transition: background 0.2s, color 0.2s; }
  .close-btn svg { width: 24px; height: 24px; }
  .close-btn:hover { background: rgba(255,255,255,0.1); color: #fff; }

  .spinner-ring { width: 60px; height: 60px; border: 4px solid rgba(255,255,255,0.1); border-top-color: #fafafa; border-radius: 50%; margin: 0 auto 1.5rem; animation: spin 1s linear infinite; }
  
  .modal-title { font-size: 1.5rem; font-weight: 700; color: #fff; margin-bottom: 1rem; }
  .modal-desc { font-size: 1rem; color: #a1a1aa; line-height: 1.5; margin-bottom: 1.5rem; }
  .modal-desc strong { color: #fff; }
  
  .manual-dl-link { font-size: 0.85rem; color: #4ecdc4; text-decoration: none; font-weight: 500; transition: color 0.2s; }
  .manual-dl-link:hover { color: #fff; text-decoration: underline; }

  @keyframes spin { 100% { transform: rotate(360deg); } }

  .ai-fade-up { opacity: 0; transform: translateY(30px); animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .delay-1 { animation-delay: 0.1s; } .delay-2 { animation-delay: 0.2s; }
  @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

  /* Responsive */
  @media (max-width: 992px) {
    .game-showcase-grid { grid-template-columns: 1fr; gap: 3rem; text-align: center; }
    .cover-art-container { max-width: 380px; margin: 0 auto; }
    .tag-flex, .developer-row, .action-bar { justify-content: center; }
    .game-about-text { margin: 0 auto 3rem; }
  }
  @media (max-width: 768px) {
    .action-bar { flex-direction: column; align-items: stretch; }
    .details-bento { grid-template-columns: 1fr; gap: 1.5rem; text-align: center; }
    .game-display-title { font-size: 2.5rem; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const parallaxBg = document.getElementById('parallax-bg') as HTMLImageElement;
    if (parallaxBg) {
      window.addEventListener('scroll', () => {
        const scrollY = window.scrollY;
        parallaxBg.style.transform = `translateY(${scrollY * 0.3}px)`;
      });
    }

    const coverCards = document.querySelectorAll('.tilt-effect');
    coverCards.forEach(card => {
      const htmlCard = card as HTMLElement;
      htmlCard.addEventListener('mousemove', (e) => {
        const rect = htmlCard.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -6; 
        const rotateY = ((x - centerX) / centerX) * 6;
        htmlCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
      });
      htmlCard.addEventListener('mouseleave', () => {
        htmlCard.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
      });
    });

    const downloadBtn = document.getElementById('download-trigger-btn');
    const modal = document.getElementById('download-modal');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const ACTUAL_DOWNLOAD_URL = "https://github.com/makineceviri/makine-istemci/releases/latest/download/MakineAI-Setup.exe";

    if (downloadBtn && modal && closeModalBtn) {
      downloadBtn.addEventListener('click', (e) => {
        e.preventDefault();
        modal.classList.add('show');
        document.body.style.overflow = 'hidden';

        setTimeout(() => {
          window.location.href = ACTUAL_DOWNLOAD_URL;
          
          const title = modal.querySelector('.modal-title');
          if (title) title.textContent = "İndirme Başladı!";
          
          const spinner = modal.querySelector('.spinner-ring') as HTMLElement;
          if (spinner) {
            spinner.style.borderTopColor = "#10b981"; 
            spinner.style.animation = "none"; 
          }
        }, 2000);
      });

      const closeModal = () => {
        modal.classList.remove('show');
        document.body.style.overflow = ''; 
      };

      closeModalBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }
  });
</script>