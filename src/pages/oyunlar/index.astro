---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

interface GamePackage {
  name: string;
  v: string;
  sizeBytes: number;
  size: number;
  dataUrl: string;
  checksum: string;
  dirName: string;
}

function slugify(name: string): string {
  const trMap: Record<string, string> = {
    'ç': 'c', 'Ç': 'c', 'ş': 's', 'Ş': 's', 'ğ': 'g', 'Ğ': 'g',
    'ü': 'u', 'Ü': 'u', 'ö': 'o', 'Ö': 'o', 'ı': 'i', 'İ': 'i',
  };
  return name
    .toLowerCase()
    .split('')
    .map(c => trMap[c] || c)
    .join('')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

const catalog = (await import('../../data/index.json')).default as {
  packages: Record<string, GamePackage>;
};

let genreData: Record<string, string[]> = {};
try {
  genreData = (await import('../../data/genres.json')).default as Record<string, string[]>;
} catch { /* ... */ }

const slugMap = new Map<string, string>();
const allGenres = new Set<string>();

const games = Object.entries(catalog.packages)
  .map(([appId, pkg]) => {
    let slug = slugify(pkg.name);
    if (slugMap.has(slug)) slug = `${slug}-${appId}`;
    slugMap.set(slug, appId);
    
    const gameGenres = genreData[appId] || ['Macera'];
    gameGenres.forEach(g => allGenres.add(g));

    return { appId, slug, genres: gameGenres, ...pkg };
  })
  .sort((a, b) => a.name.localeCompare(b.name, 'tr'));

const uniqueGenres = Array.from(allGenres).sort();

const bgImages = [
  "1174180", "1245620", "2358720", "2651280", "990080"
].map(id => `https://cdn.akamai.steamstatic.com/steam/apps/${id}/library_hero.jpg`);

const featuredGames = games.filter(g => ["1174180", "1245620"].includes(g.appId));
const dubPool = new Set(["1245620", "266840"]);

const siteUrl = 'https://makineceviri.net';
const pageUrl = `${siteUrl}/oyunlar`;
const pageTitle = 'Oyun Kütüphanesi — Makine Çeviri';
const pageDesc = `${games.length}+ oyun için yüksek kaliteli Türkçe yama kütüphanesi.`;

const clientGames = JSON.stringify(games.map(g => ({ name: g.name, appId: g.appId, slug: g.slug, genres: g.genres })));
---

<Layout title={pageTitle} description={pageDesc} canonical={pageUrl}>
  <Navbar showSearch={false} />

  <main class="clean-store-main">
    
    <div class="hero-bg-container">
      {bgImages.map((img, idx) => (
        <div class={`hero-slide ${idx === 0 ? 'active' : ''}`} style={`background-image: url('${img}')`}></div>
      ))}
      <div class="hero-vignette"></div>
    </div>

    <div class="store-container">
      
      <header class="store-header ai-fade-up">
        <h1 class="display-title">Oyun Kütüphanesi</h1>
        <p class="display-subtitle">Sıfır performans kayıplı, yüksek kaliteli <strong>{games.length}</strong> Türkçe yama.</p>

        <div class="solid-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="game-search" placeholder="Kütüphanede ara..." autocomplete="off" spellcheck="false" />
        </div>
      </header>

      <section class="smart-discovery ai-fade-up delay-1" id="discovery-section">
        <div class="discovery-panel">
          
          <div class="d-content">
            <h2 class="d-title">Ne Oynasam?</h2>
            <p class="d-desc">Bir tür seçin, kütüphanemizden size en uygun oyunu rastgele çekelim.</p>
            
            <div class="d-actions">
              
              <div class="custom-dropdown" id="genre-dropdown">
                <div class="dropdown-header">
                  <span id="selected-genre-text">Tüm Türler</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
                <ul class="dropdown-list">
                  <li class="dropdown-item active" data-value="all">Tüm Türler</li>
                  {uniqueGenres.map(g => (
                    <li class="dropdown-item" data-value={g}>{g}</li>
                  ))}
                </ul>
              </div>

              <button id="btn-suggest" class="btn-primary">Oyunu Çek</button>
            </div>
          </div>
          
          <div class="d-result-area" id="result-area">
            <div class="empty-placeholder" id="placeholder-state">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Seçim yapmanız bekleniyor...</span>
            </div>
          </div>

        </div>
      </section>

      <section class="section-block ai-fade-up delay-2" id="showcase-section">
        <h3 class="section-heading">Öne Çıkanlar</h3>
        <div class="showcase-grid">
          {featuredGames.map((game) => (
            <a href={`/oyunlar/${game.slug}`} class="showcase-item tilt-effect">
              <div class="showcase-visual">
                <img src={`https://cdn.akamai.steamstatic.com/steam/apps/${game.appId}/library_hero.jpg`} alt={game.name} class="sc-img" onerror={`this.onerror=null;this.src="https://cdn.makineceviri.net/assets/images/${game.appId}.png"`} />
                <div class="sc-fade"></div>
                <div class="sc-data">
                  <h4 class="sc-title">{game.name}</h4>
                  <span class="sc-btn">Detayları Gör</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="section-block ai-fade-up delay-3">
        <div class="catalog-header">
          <h3 class="section-heading">Tüm Koleksiyon</h3>
          <span class="game-count">{games.length} Oyun</span>
        </div>

        <div class="library-grid" id="library-grid">
          {games.map((game) => (
            <a href={`/oyunlar/${game.slug}`} class="game-card" data-name={game.name.toLowerCase()}>
              <div class="card-visual">
                <img src={`https://cdn.akamai.steamstatic.com/steam/apps/${game.appId}/header.jpg`} alt={game.name} loading="lazy" onerror={`this.onerror=null;this.src="https://cdn.makineceviri.net/assets/images/${game.appId}.png"`} />
                {dubPool.has(game.appId) && <div class="dub-tag">Dublaj</div>}
                <div class="hover-overlay">
                  <span class="hover-pill">İncele</span>
                </div>
              </div>
              <div class="card-meta">
                <h4 class="g-name" title={game.name}>{game.name}</h4>
                <span class="g-genre">{game.genres[0] || 'Oyun'}</span>
              </div>
            </a>
          ))}
        </div>

        <div class="empty-state" id="empty-state" style="display:none;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <h3>Sonuç Bulunamadı</h3>
          <p>Farklı bir arama yapmayı deneyin.</p>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>

<script define:vars={{ clientGames }}>
  window.GAMES_DATA = JSON.parse(clientGames);
</script>

<style>
  .clean-store-main { position: relative; min-height: 100vh; padding-top: 130px; padding-bottom: 100px; background: #09090b; color: #fafafa; }

  .hero-bg-container { position: absolute; top: 0; left: 0; width: 100%; height: 80vh; z-index: 0; overflow: hidden; pointer-events: none; }
  .hero-slide { position: absolute; inset: 0; background-size: cover; background-position: center top; opacity: 0; transition: opacity 1.5s ease-in-out; filter: brightness(0.4); will-change: opacity; }
  .hero-slide.active { opacity: 1; }
  .hero-vignette { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(9,9,11,0) 0%, rgba(9,9,11,0.6) 40%, #09090b 100%); }

  .store-container { max-width: 1300px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 2; }

  .store-header { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 4rem; }
  .display-title { font-size: clamp(3rem, 6vw, 4.5rem); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.5rem; text-shadow: 0 4px 20px rgba(0,0,0,0.5); }
  .display-subtitle { font-size: 1.15rem; color: #a1a1aa; font-weight: 400; margin-bottom: 2.5rem; }

  .solid-search { width: 100%; max-width: 550px; display: flex; align-items: center; background: rgba(24, 24, 27, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 0 24px; transition: all 0.3s; box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
  .solid-search:focus-within { background: rgba(39, 39, 42, 0.9); border-color: #fff; box-shadow: 0 15px 40px rgba(0,0,0,0.5); transform: translateY(-2px); }
  .solid-search svg { width: 22px; height: 22px; color: #a1a1aa; margin-right: 14px; transition: color 0.3s; }
  .solid-search:focus-within svg { color: #fff; }
  .solid-search input { flex: 1; height: 60px; background: transparent; border: none; outline: none; color: #fff; font-size: 1.1rem; }
  .solid-search input::placeholder { color: #71717a; }

  .smart-discovery { position: relative; z-index: 100; margin-bottom: 5rem; }
  
  .discovery-panel {
    display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: stretch;
    background: #18181b; border: 1px solid rgba(255,255,255,0.05);
    border-radius: 20px; padding: 3rem; box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }
  
  .d-content { position: relative; z-index: 50; display: flex; flex-direction: column; justify-content: center; }
  .d-title { font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; line-height: 1.2; color: #fff; }
  .d-desc { color: #a1a1aa; font-size: 1.05rem; margin-bottom: 2rem; line-height: 1.5; }
  .d-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  
  .custom-dropdown { position: relative; flex: 1; min-width: 220px; font-family: inherit; z-index: 100; }
  .dropdown-header { display: flex; justify-content: space-between; align-items: center; height: 52px; background: #09090b; border: 1px solid rgba(255,255,255,0.15); border-radius: 12px; padding: 0 20px; color: #fff; font-size: 0.95rem; cursor: pointer; transition: border-color 0.3s, box-shadow 0.3s; }
  .dropdown-header:hover { border-color: rgba(255,255,255,0.3); }
  .custom-dropdown.open .dropdown-header { border-color: #4ecdc4; box-shadow: 0 0 0 3px rgba(78,205,196,0.15); }
  .dropdown-header svg { width: 16px; height: 16px; color: #a1a1aa; transition: transform 0.3s; }
  .custom-dropdown.open .dropdown-header svg { transform: rotate(180deg); color: #4ecdc4; }
  
  .dropdown-list {
    position: absolute; top: calc(100% + 8px); left: 0; width: 100%;
    background: rgba(24, 24, 27, 0.98); border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px; padding: 8px; backdrop-filter: blur(20px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.9); z-index: 9999;
    max-height: 240px; overflow-y: auto; list-style: none; margin: 0;
    opacity: 0; pointer-events: none; transform: translateY(-10px); transition: all 0.2s ease-out;
  }
  .custom-dropdown.open .dropdown-list { opacity: 1; pointer-events: auto; transform: translateY(0); }
  .dropdown-list::-webkit-scrollbar { width: 6px; }
  .dropdown-list::-webkit-scrollbar-track { background: transparent; }
  .dropdown-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 10px; }
  
  .dropdown-item { padding: 12px 16px; border-radius: 8px; color: #d4d4d8; font-size: 0.95rem; cursor: pointer; transition: background 0.2s, color 0.2s; }
  .dropdown-item:hover { background: rgba(255,255,255,0.08); color: #fff; }
  .dropdown-item.active { background: rgba(212, 168, 67, 0.15); color: #d4a843; font-weight: 600; }
  
  .btn-primary { height: 52px; padding: 0 28px; background: #fff; color: #000; font-weight: 700; font-size: 1rem; border: none; border-radius: 12px; cursor: pointer; transition: all 0.3s; white-space: nowrap; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(255,255,255,0.2); background: #e4e4e7; }

  /* GÖRSEL ALANI: İç boşluk yok (padding:0), resim tam oturur */
  .d-result-area { 
    position: relative; 
    width: 100%; 
    height: 100%; /* Sol kısımla aynı boy */
    min-height: 220px; 
    background: #09090b; 
    border-radius: 16px; 
    border: 1px solid rgba(255,255,255,0.05); 
    overflow: hidden; 
    display: flex; align-items: center; justify-content: center; 
    z-index: 10; 
    padding: 0 !important; 
  }
  
  .empty-placeholder { display: flex; flex-direction: column; align-items: center; gap: 12px; color: #71717a; font-size: 1.05rem; font-weight: 500; }
  .empty-placeholder svg { width: 32px; height: 32px; opacity: 0.5; }
  
  .slot-flash { position: absolute; inset: 0; background: #fff; z-index: 10; opacity: 0; pointer-events: none; }
  .slot-flash.active { animation: flashFade 0.5s ease-out forwards; }
  @keyframes flashFade { 0% { opacity: 1; } 100% { opacity: 0; } }

  /* KAZANAN KART KUTUSU: Sınırları tam kaplar */
  .suggested-card {
    position: absolute; inset: 0; width: 100%; height: 100%; 
    display: block; text-decoration: none; z-index: 20;
    opacity: 0; transform: scale(0.95); transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    background: #000; border-radius: inherit;
  }
  .suggested-card.show { opacity: 1; transform: scale(1); }
  
  /* KAZANAN RESİM: object-fit: cover ile boşlukları %100 yok eder */
  .s-bg-img { 
    width: 100%; height: 100%; 
    object-fit: cover !important; 
    object-position: center; 
    transition: transform 0.6s ease; display: block; 
  }
  .suggested-card:hover .s-bg-img { transform: scale(1.05); }

  .section-block { position: relative; z-index: 10; margin-bottom: 5rem; }
  .section-heading { font-size: 1.6rem; font-weight: 700; color: #fff; letter-spacing: -0.02em; margin-bottom: 1.5rem; }

  .showcase-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .showcase-item { position: relative; display: block; text-decoration: none; perspective: 1000px; }
  .showcase-visual { position: relative; width: 100%; aspect-ratio: 21/9; border-radius: 16px; overflow: hidden; background: #18181b; border: 1px solid rgba(255,255,255,0.05); box-shadow: 0 15px 30px rgba(0,0,0,0.4); transform-style: preserve-3d; transition: transform 0.2s ease-out, border-color 0.3s, box-shadow 0.3s; }
  .sc-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); filter: brightness(0.85); }
  .sc-fade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(9,9,11,0.95) 0%, transparent 60%); pointer-events: none; }
  .sc-data { position: absolute; bottom: 0; left: 0; padding: 2rem; transform: translateZ(20px); }
  .sc-title { font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 800; color: #fff; margin-bottom: 1rem; text-shadow: 0 4px 15px rgba(0,0,0,0.8); }
  .sc-btn { display: inline-flex; background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); color: #fff; font-weight: 600; font-size: 0.9rem; padding: 10px 24px; border-radius: 100px; border: 1px solid rgba(255,255,255,0.1); transition: all 0.3s; }

  .showcase-item:hover .showcase-visual { border-color: rgba(255,255,255,0.3); box-shadow: 0 25px 50px rgba(0,0,0,0.6); }
  .showcase-item:hover .sc-img { transform: scale(1.05); filter: brightness(1); }
  .showcase-item:hover .sc-btn { background: #fff; color: #000; border-color: #fff; }

  .catalog-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem; }
  .game-count { color: #71717a; font-size: 1.1rem; }
  .library-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2.5rem 1.5rem; }
  .game-card { text-decoration: none; display: flex; flex-direction: column; gap: 12px; }
  .card-visual { position: relative; width: 100%; aspect-ratio: 16/9; border-radius: 12px; overflow: hidden; background: #18181b; border: 1px solid rgba(255,255,255,0.05); box-shadow: 0 10px 20px rgba(0,0,0,0.3); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s, border-color 0.4s; }
  .card-visual img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; filter: brightness(0.9); }
  .dub-tag { position: absolute; top: 10px; right: 10px; background: rgba(255,255,255,0.95); color: #000; font-size: 0.7rem; font-weight: 800; padding: 4px 8px; border-radius: 6px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); z-index: 2; }
  .hover-overlay { position: absolute; inset: 0; background: rgba(9,9,11,0.5); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s; backdrop-filter: blur(2px); z-index: 3; }
  .hover-pill { background: #fff; color: #000; font-size: 0.9rem; font-weight: 700; padding: 10px 24px; border-radius: 100px; transform: translateY(15px); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); box-shadow: 0 10px 20px rgba(0,0,0,0.3); }

  .game-card:hover .card-visual { transform: translateY(-6px); border-color: rgba(255,255,255,0.3); box-shadow: 0 20px 40px rgba(0,0,0,0.6); }
  .game-card:hover img { transform: scale(1.05); filter: brightness(1.1); }
  .game-card:hover .hover-overlay { opacity: 1; }
  .game-card:hover .hover-pill { transform: translateY(0); }

  .card-meta { padding: 0 4px; transition: transform 0.3s; }
  .game-card:hover .card-meta { transform: translateY(4px); }
  .g-name { font-size: 1.05rem; font-weight: 600; color: #e4e4e7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 2px; transition: color 0.3s; }
  .game-card:hover .g-name { color: #fff; }
  .g-genre { font-size: 0.85rem; color: #71717a; }

  .empty-state { text-align: center; padding: 6rem 0; color: #a1a1aa; }
  .empty-state svg { width: 48px; height: 48px; margin-bottom: 1rem; color: #52525b; }
  .empty-state h3 { color: #fff; font-size: 1.4rem; margin-bottom: 0.5rem; font-weight: 500; }

  .ai-fade-up { opacity: 0; transform: translateY(30px); animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .delay-1 { animation-delay: 0.1s; } .delay-2 { animation-delay: 0.2s; } .delay-3 { animation-delay: 0.3s; }
  @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 992px) {
    .discovery-panel { grid-template-columns: 1fr; gap: 2rem; text-align: center; }
    .d-actions { justify-content: center; }
    .showcase-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    .display-title { font-size: 2.5rem; }
    .library-grid { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    
    const slides = document.querySelectorAll('.hero-slide');
    let currentSlide = 0;
    if (slides.length > 1) {
      setInterval(() => {
        slides[currentSlide].classList.remove('active');
        currentSlide = (currentSlide + 1) % slides.length;
        slides[currentSlide].classList.add('active');
      }, 7000); 
    }

    const dropdown = document.getElementById('genre-dropdown');
    let currentGenre = 'all'; 
    
    if (dropdown) {
      const header = dropdown.querySelector('.dropdown-header') as HTMLElement;
      const selectedText = document.getElementById('selected-genre-text') as HTMLElement;
      const items = dropdown.querySelectorAll('.dropdown-item');

      header.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdown.classList.toggle('open');
      });

      items.forEach(item => {
        item.addEventListener('click', (e) => {
          e.stopPropagation();
          items.forEach(i => i.classList.remove('active'));
          item.classList.add('active');
          currentGenre = (item as HTMLElement).dataset.value || 'all';
          selectedText.textContent = item.textContent;
          dropdown.classList.remove('open');
        });
      });

      document.addEventListener('click', (e) => {
        if (!dropdown.contains(e.target as Node)) {
          dropdown.classList.remove('open');
        }
      });
    }

    // --- SIFIR BOŞLUK BIRAKAN JAVASCRIPT GÜNCELLEMESİ ---
    const gamesData = (window as any).GAMES_DATA || [];
    const btnSuggest = document.getElementById('btn-suggest');
    const resultArea = document.getElementById('result-area');

    if (btnSuggest && resultArea && gamesData.length > 0) {
      btnSuggest.addEventListener('click', () => {
        
        let filteredGames = gamesData;
        if (currentGenre !== 'all') {
          filteredGames = gamesData.filter((g: any) => g.genres.includes(currentGenre));
        }
        if (filteredGames.length === 0) filteredGames = gamesData;

        btnSuggest.style.pointerEvents = 'none';
        btnSuggest.textContent = 'Oyun Seçiliyor...';
        
        let flash = document.createElement('div');
        flash.className = 'slot-flash';
        resultArea.appendChild(flash);

        let counter = 0;
        const maxTicks = 18; 
        
        const spinTimer = setInterval(() => {
          const randomGame = filteredGames[Math.floor(Math.random() * filteredGames.length)];
          const bgImg = `https://cdn.akamai.steamstatic.com/steam/apps/${randomGame.appId}/header.jpg`;
          const fallbackImg = `https://cdn.makineceviri.net/assets/images/${randomGame.appId}.png`;

          // Dönerken de boşluk bırakmaması için JS içine %100 Cover kodu gömüldü!
          resultArea.innerHTML = `
            <div class="slot-reel" style="position: absolute; inset: 0; width: 100%; height: 100%;">
              <img src="${bgImg}" class="slot-img" style="width: 100%; height: 100%; object-fit: cover; display: block;" onerror="this.onerror=null;this.src='${fallbackImg}';" />
            </div>
            <div class="slot-flash"></div>
          `;
          
          counter++;

          if (counter >= maxTicks) {
            clearInterval(spinTimer);
            const finalGame = filteredGames[Math.floor(Math.random() * filteredGames.length)];
            
            const finalImg = `https://cdn.akamai.steamstatic.com/steam/apps/${finalGame.appId}/header.jpg`;
            const finalFallback = `https://cdn.makineceviri.net/assets/images/${finalGame.appId}.png`;
            
            const finalFlash = resultArea.querySelector('.slot-flash') as HTMLElement;
            if (finalFlash) finalFlash.classList.add('active');

            setTimeout(() => {
              resultArea.innerHTML = `
                <a href="/oyunlar/${finalGame.slug}" class="suggested-card">
                  <img src="${finalImg}" class="s-bg-img" style="width: 100%; height: 100%; object-fit: cover; display: block;" onerror="this.onerror=null;this.src='${finalFallback}';" />
                </a>
              `;
              
              setTimeout(() => {
                const card = resultArea.querySelector('.suggested-card');
                if(card) card.classList.add('show');
              }, 50);
              
              btnSuggest.style.pointerEvents = 'auto';
              btnSuggest.textContent = 'Tekrar Çek';
            }, 150); 
          }
        }, 70); 
      });
    }

    const input = document.getElementById('game-search') as HTMLInputElement;
    const grid = document.getElementById('library-grid');
    const showcaseSection = document.getElementById('showcase-section');
    const discoverySection = document.getElementById('discovery-section');
    const emptyState = document.getElementById('empty-state');
    
    if (grid && input && showcaseSection && discoverySection && emptyState) {
      const cards = Array.from(grid.querySelectorAll('.game-card')) as HTMLElement[];
      const trLower = (s: string) => s.replace(/İ/g, 'i').replace(/I/g, 'ı').toLowerCase();

      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement !== input) {
          e.preventDefault();
          input.focus();
        }
      });

      let searchTimeout: any;

      input.addEventListener('input', () => {
        const query = trLower(input.value.trim());
        
        if (query.length > 0) {
          showcaseSection.style.display = 'none'; 
          discoverySection.style.display = 'none'; 
        } else {
          showcaseSection.style.display = 'block';
          discoverySection.style.display = 'block';
        }

        clearTimeout(searchTimeout);
        
        searchTimeout = setTimeout(() => {
          let visibleCount = 0;
          cards.forEach((card) => {
            const gameName = card.dataset.name || '';
            if (!query || trLower(gameName).includes(query)) {
              card.style.display = 'flex';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });
          emptyState.style.display = (visibleCount === 0 && query) ? 'block' : 'none';
        }, 150); 
      });
    }

    const coverCards = document.querySelectorAll('.tilt-effect');
    coverCards.forEach(card => {
      const htmlCard = card as HTMLElement;
      htmlCard.addEventListener('mousemove', (e) => {
        const rect = htmlCard.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -4; 
        const rotateY = ((x - centerX) / centerX) * 4;
        htmlCard.querySelector('.showcase-visual')!.setAttribute('style', `transform: perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`);
      });
      htmlCard.addEventListener('mouseleave', () => {
        htmlCard.querySelector('.showcase-visual')!.setAttribute('style', `transform: perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`);
      });
    });

  });
</script>