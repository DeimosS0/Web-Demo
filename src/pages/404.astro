---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sayfa Bulunamadı — Makine Çeviri">
  <div class="not-found">
    <div class="not-found-content">
      <img src="/images/logo.png" alt="Makine Çeviri" class="not-found-logo" />
      <h1>404</h1>
      <p>Aradığın sayfa bulunamadı.</p>
      <a href="/" class="not-found-btn">Ana Sayfaya Dön</a>
    </div>
  </div>
</Layout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    text-align: center;
    padding: 2rem;
  }

  .not-found-content {
    max-width: 420px;
  }

  .not-found-logo {
    width: 64px;
    height: 64px;
    margin-bottom: 1.5rem;
    opacity: 0.7;
  }

  .not-found h1 {
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: 700;
    line-height: 1;
    margin: 0;
    background: linear-gradient(135deg, var(--gold) 0%, var(--text-faint) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .not-found p {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin: 0.75rem 0 2rem;
  }

  .not-found-btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: var(--gold);
    color: var(--bg);
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: 999px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .not-found-btn:hover {
    opacity: 0.85;
  }
</style>
