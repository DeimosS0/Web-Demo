</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    
    // --- 1. OTOMATİK OYNATILAN REHBER (AUTO-PLAY) ---
    const triggers = document.querySelectorAll('.step-trigger');
    const layers = document.querySelectorAll('.visual-layer');
    let currentStep = 1;
    let autoPlayInterval: any;
    const STEP_DURATION = 5000; 

    function switchStep(stepIndex: number) {
      currentStep = stepIndex;
      
      triggers.forEach(t => {
        if (parseInt(t.getAttribute('data-step') || '1') === currentStep) {
          t.classList.remove('active');
          void (t as HTMLElement).offsetWidth; 
          t.classList.add('active');
        } else {
          t.classList.remove('active');
        }
      });

      layers.forEach(layer => {
        if (layer.id === `layer-${currentStep}`) {
          layer.classList.add('active');
        } else {
          layer.classList.remove('active');
        }
      });
    }

    function nextStep() {
      let next = currentStep + 1;
      if (next > 3) next = 1;
      switchStep(next);
    }

    function startAutoPlay() {
      autoPlayInterval = setInterval(nextStep, STEP_DURATION);
    }

    function resetAutoPlay() {
      clearInterval(autoPlayInterval);
      startAutoPlay();
    }

    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const step = parseInt(trigger.getAttribute('data-step') || '1');
        switchStep(step);
        resetAutoPlay(); 
      });
    });

    startAutoPlay();

    // --- 2. DONANIMSAL MANYETİK PARLAMA ---
    const visualBoard = document.getElementById('visual-board');
    const glow = document.getElementById('h-glow');
    let mouseX = 0;
    let mouseY = 0;
    let isHovering = false;

    const updateGlow = () => {
      if (isHovering && glow) {
        glow.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;
        requestAnimationFrame(updateGlow);
      }
    };

    if (visualBoard && glow) {
      visualBoard.addEventListener('mousemove', (e) => {
        const rect = visualBoard.getBoundingClientRect();
        mouseX = e.clientX - rect.left;
        mouseY = e.clientY - rect.top;
      });
      visualBoard.addEventListener('mouseenter', () => {
        isHovering = true;
        requestAnimationFrame(updateGlow);
      });
      visualBoard.addEventListener('mouseleave', () => {
        isHovering = false;
      });
    }

    // --- 3. KART TİLT (EĞİM) EFEKTİ ---
    const tiltWrapper = document.querySelector('.tilt-effect') as HTMLElement;
    const glassPanel = document.querySelector('.glass-panel') as HTMLElement;
    
    if (tiltWrapper && glassPanel) {
      tiltWrapper.addEventListener('mousemove', (e) => {
        const rect = tiltWrapper.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -3; 
        const rotateY = ((x - centerX) / centerX) * 3;
        glassPanel.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
      });
      tiltWrapper.addEventListener('mouseleave', () => {
        glassPanel.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
      });
    }

    // --- 4. VERİTABANI (TYPEWRITER) MANTIĞI ---
    const buttons = document.querySelectorAll('.query-btn');
    const outputElement = document.getElementById('typewriter-output');
    const firstAnswer = buttons[0]?.getAttribute('data-answer') || '';
    let typingInterval: any;
    let scrambleInterval: any;

    const typeWriter = (text: string, element: HTMLElement) => {
      clearInterval(typingInterval);
      clearInterval(scrambleInterval);
      element.innerHTML = ''; 
      
      let i = 0;
      const chars = '!<>-_\\/[]{}—=+*^?#_';
      let scrambleCycles = 0;
      
      scrambleInterval = setInterval(() => {
        let gibberish = '';
        for(let j=0; j<15; j++) {
          gibberish += chars[Math.floor(Math.random() * chars.length)];
        }
        element.innerHTML = `<span class="scrambled">${gibberish}</span>`;
        scrambleCycles++;
        
        if(scrambleCycles > 5) {
          clearInterval(scrambleInterval);
          element.innerHTML = '';
          
          typingInterval = setInterval(() => {
            if (i < text.length) {
              element.innerHTML += text.charAt(i);
              i++;
            } else {
              clearInterval(typingInterval);
            }
          }, 15); 
        }
      }, 30);
    };

    if(outputElement) {
      typeWriter(firstAnswer, outputElement);
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        if(btn.classList.contains('active')) return;

        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        const answer = btn.getAttribute('data-answer');
        if (answer && outputElement) {
          typeWriter(answer, outputElement);
        }
      });
    });

  });
</script>