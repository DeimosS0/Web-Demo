    .faq-interface { flex-direction: column; }
    .answer-terminal { min-height: 350px; }
    .queries-wrapper { height: 250px; } /* Mobilde kaydırma alanı yüksekliği */
    .discord-glass { flex-direction: column; text-align: center; padding: 3rem 2rem; }
    .d-text p { margin: 0 auto; }
