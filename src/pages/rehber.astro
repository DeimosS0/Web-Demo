---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const siteUrl = 'https://makineceviri.net';
const pageUrl = `${siteUrl}/rehber`;
const pageTitle = 'Sistem Rehberi — Makine Çeviri';
const pageDesc = 'MakineAI altyapısı nasıl kurulur, Türkçe yama nasıl entegre edilir ve veritabanı sorguları.';

// Terminal Arayüzü İçin Veritabanı (Sorunlar ve SSS)
const terminalData = [
  {
    id: "01",
    q: "Windows 'Güvenli Olmayabilir' uyarısı veriyor",
    a: "Uyarı ekranındaki 'Daha fazla bilgi' yazısına tıklayın, ardından 'Yine de çalıştır' butonuna basın. MakineAI %100 güvenlidir, Windows dijital sertifikası olmayan yeni araçlar için bu standart uyarıyı verir."
  },
  {
    id: "02",
    q: "Antivirüs yazılımı kurulumu engelliyor",
    a: "Antivirüs ayarlarınızdan MakineAI klasörünü 'İstisnalar' (Exclusions) listesine ekleyin. Programımız oyun dosyalarına sanal müdahale ettiği için bazı korumalar bunu yanlış (false-positive) algılayabilir."
  },
  {
    id: "03",
    q: "Kurulumda 'Dosya Kilitli / Yazma İzni Yok' hatası",
    a: "Oyunu ve Steam/Epic istemcisini arka plandan tamamen kapatın. Sorun devam ederse MakineAI simgesine sağ tıklayıp 'Yönetici olarak çalıştır' seçeneğini kullanarak gerekli izinleri sağlayın."
  },
  {
    id: "04",
    q: "Orijinal oyun dosyalarım bozulur mu?",
    a: "Hayır. Sistemimiz memory-bypass ve sanal katman mantığıyla çalışır. Her dosya öncesinde yedeklenir. Yamayı kaldırdığınız an oyun saniyeler içinde orijinal haline döner."
  },
  {
    id: "05",
    q: "Oyun resmi güncelleme alırsa ne olur?",
    a: "Oyun yapımcısı büyük bir güncelleme yayınlarsa yama güvenlik gereği geçici olarak askıya alınır. MakineAI veritabanı güncellendiğinde istemci üzerinden tek tıkla yamayı yeni sürüme adapte edebilirsiniz."
  },
  {
    id: "06",
    q: "Çeviri sırasında FPS kaybı yaşar mıyım?",
    a: "Sistem kaynaklarınızı korumak ana önceliğimizdir. Çeviri işlemleri GPU'yu yormaz. C++ altyapımız sayesinde işlemci (CPU) tüketimi %0.1 ile %0.5 arasındadır. Performans etkilenmez."
  },
  {
    id: "07",
    q: "Çevrimdışı (Offline) oynayabilir miyim?",
    a: "Evet. Kurulumu bir kez tamamladığınızda yamalar diskinize entegre edilir. İnternet bağlantınız olmasa dahi oyunlarınızı Türkçe oynamaya devam edebilirsiniz."
  },
  {
    id: "08",
    q: "Sistem tamamen ücretsiz mi?",
    a: "Evet, %100 ücretsizdir. Makine Çeviri topluluk odaklı bir projedir. İstemcide herhangi bir reklam, zorunlu abonelik veya gizli ücretlendirme bulunmaz."
  }
];
---

<Layout title={pageTitle} description={pageDesc} canonical={pageUrl}>
  <Navbar showSearch={false} />

  <main class="galaxy-playground-main">
    
    <div class="galaxy-bg">
      <div class="nebula-blob nebula-1"></div>
      <div class="nebula-blob nebula-2"></div>
      <div class="stars layer-1"></div>
      <div class="stars layer-2"></div>
    </div>

    <div class="playground-container">
      
      <header class="playground-hero ai-fade-up">
        <h1 class="hero-title">
          Sınırları Kaldırın. <br />
          <span class="text-gradient">Oyunlara Hükmedin.</span>
        </h1>
        <p class="hero-subtitle">
          MakineAI altyapısıyla oyunlarınızı Türkçe yapmak hiç bu kadar pürüzsüz olmamıştı. Aşağıdaki üç adımı izleyerek saniyeler içinde sistemi aktif edin.
        </p>
      </header>

      <section class="interactive-guide ai-fade-up delay-1">
        
        <div class="guide-nav">
          <button class="step-trigger active" data-step="1">
            <div class="step-indicator"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></div>
            <div class="step-content">
              <h3>Sistemi İndirin</h3>
              <p>MakineAI çekirdeğini bilgisayarınıza kurun.</p>
            </div>
            <div class="progress-track"><div class="progress-fill"></div></div>
          </button>

          <button class="step-trigger" data-step="2">
            <div class="step-indicator"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div>
            <div class="step-content">
              <h3>Diski Tarayın</h3>
              <p>Sistem, yüklü oyunlarınızı otomatik tespit eder.</p>
            </div>
            <div class="progress-track"><div class="progress-fill"></div></div>
          </button>

          <button class="step-trigger" data-step="3">
            <div class="step-indicator"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div>
            <div class="step-content">
              <h3>Entegre Edin</h3>
              <p>Yamayı kurun ve saniyeler içinde oynamaya başlayın.</p>
            </div>
            <div class="progress-track"><div class="progress-fill"></div></div>
          </button>
        </div>

        <div class="guide-visual-wrapper tilt-effect" id="visual-board">
          <div class="guide-visual glass-panel">
            <div class="hardware-glow" id="h-glow"></div>
            
            <div class="visual-layer active" id="layer-1">
              <div class="mockup-window">
                <div class="m-header"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span></div>
                <div class="m-body flex-center">
                  <div class="apple-dl-ui">
                    <div class="dl-circle-wrap">
                      <svg viewBox="0 0 100 100" class="dl-svg">
                        <circle cx="50" cy="50" r="46" class="dl-bg"></circle>
                        <circle cx="50" cy="50" r="46" class="dl-progress"></circle>
                      </svg>
                      <div class="dl-icon-center">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="4" x2="12" y2="16"/><polyline points="7 11 12 16 17 11"/></svg>
                      </div>
                    </div>
                    <div class="apple-dl-text">MakineAI_Setup.exe İndiriliyor</div>
                  </div>
                </div>
              </div>
            </div>

            <div class="visual-layer" id="layer-2">
              <div class="mockup-window">
                <div class="m-header"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span></div>
                <div class="m-body flex-center flex-column">
                  <div class="apple-scan-grid">
                    <div class="scan-card sc-1"><div class="sc-img"></div><div class="sc-line"></div></div>
                    <div class="scan-card sc-2"><div class="sc-img"></div><div class="sc-line"></div></div>
                    <div class="scan-card sc-3"><div class="sc-img"></div><div class="sc-line"></div></div>
                    <div class="scan-card sc-4"><div class="sc-img"></div><div class="sc-line"></div></div>
                    
                    <div class="glass-sweep"></div> </div>
                  <div class="apple-scan-text">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    Kütüphane Taranıyor...
                  </div>
                </div>
              </div>
            </div>

            <div class="visual-layer" id="layer-3">
              <div class="mockup-window">
                <div class="m-header"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span></div>
                <div class="m-body flex-center blur-bg">
                  <div class="apple-success-ui">
                    <div class="success-circle">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12" class="check-draw"></polyline>
                      </svg>
                    </div>
                    <h2 class="apple-success-title">Sistem Entegre Edildi</h2>
                    <button class="apple-play-btn">Oyunu Başlat</button>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>

      </section>

      <section class="sys-req-section ai-fade-up delay-2">
        <div class="req-glass-card">
          <div class="req-left">
            <h3>Donanım Profili</h3>
            <p>MakineAI, en düşük özellikli sistemlerde bile arka planda hissettirmeden çalışacak şekilde tasarlanmıştır.</p>
          </div>
          <div class="req-right">
            <div class="req-item"><span>İşletim Sistemi</span> <strong>Windows 10 / 11 (64-bit)</strong></div>
            <div class="req-item"><span>Depolama</span> <strong>90 MB İstemci Alanı</strong></div>
            <div class="req-item"><span>Ağ Durumu</span> <strong>İnternet Bağlantısı Gerekli</strong></div>
          </div>
        </div>
      </section>

      <section id="sss" class="faq-section ai-fade-up delay-3">
        <div class="cyber-grid"></div>

        <div class="faq-container">
          <div class="section-header">
            <h2 class="section-title">
              Sistem <span class="metallic-text" data-text="Veritabanı.">Veritabanı.</span>
            </h2>
            <p class="section-subtitle">
              MakineAI motorunun işleyişi, güvenlik protokolleri ve hata çözümleri hakkında merak edilenleri veri tabanımızdan sorgulayın.
            </p>
          </div>

          <div class="faq-interface">
            
            <div class="query-list">
              <div class="list-header">
                <span class="pulse-dot"></span> BEKLEYEN SORGULAR
              </div>
              <div class="queries-wrapper">
                <div class="queries">
                  {terminalData.map((faq, index) => (
                    <button class={`query-btn ${index === 0 ? 'active' : ''}`} data-answer={faq.a}>
                      <div class="q-content">
                        <span class="q-id">Q_{faq.id}</span>
                        <span class="q-text">{faq.q}</span>
                      </div>
                      <div class="active-indicator"></div>
                    </button>
                  ))}
                </div>
              </div>
            </div>

            <div class="answer-terminal">
              <div class="terminal-top">
                <div class="t-dots"><span></span><span></span><span></span></div>
                <div class="t-status">AĞ BAĞLANTISI: <span class="cyan">STABİL</span></div>
              </div>
              
              <div class="terminal-display">
                <div class="ai-response-wrapper">
                  <span class="sys-tag">[MakineAI_Core] >_ </span>
                  <span id="typewriter-output" class="typewriter-text">Sorgu seçiliyor...</span>
                  <span class="cursor"></span>
                </div>
              </div>
              
              <div class="terminal-footer">
                <div class="barcode"></div>
                <div class="hex-data">0x00A1 0x1B8F 0x9C22</div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <section class="discord-module ai-fade-up delay-3">
        <div class="discord-glass">
          <div class="d-icon">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
          </div>
          <div class="d-text">
            <h2>Ana Ağa Bağlanın</h2>
            <p>68.000'den fazla kullanıcının bulunduğu topluluğumuza katılın, çözemediğiniz konularda anında destek alın.</p>
          </div>
          <a href="https://discord.com/invite/QDezpy4QtV" target="_blank" class="d-btn">Discord'a Katıl</a>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* --- 1. GENEL DÜZEN VE OPTİMİZE ARKA PLAN --- */
  .galaxy-playground-main { position: relative; min-height: 100vh; padding-top: 150px; padding-bottom: 100px; background: #030305; color: #fafafa; overflow: hidden; font-family: inherit; }
  .galaxy-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .nebula-blob { position: absolute; border-radius: 50%; mix-blend-mode: screen; }
  .nebula-1 { top: -30%; left: -10%; width: 80vw; height: 80vw; background: radial-gradient(circle, rgba(78, 205, 196, 0.1) 0%, transparent 60%); }
  .nebula-2 { bottom: -20%; right: -20%; width: 70vw; height: 70vw; background: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, transparent 60%); }
  .stars { position: absolute; inset: -50%; background-image: radial-gradient(1px 1px at 20px 30px, #fff, rgba(0,0,0,0)), radial-gradient(1px 1px at 40px 70px, #ffffff, rgba(0,0,0,0)), radial-gradient(2px 2px at 90px 40px, #fff, rgba(0,0,0,0)); background-repeat: repeat; background-size: 200px 200px; animation: starTwinkle 5s infinite alternate; }
  .layer-1 { opacity: 0.5; }
  .layer-2 { background-size: 350px 350px; opacity: 0.3; animation-delay: 2s; transform: rotate(20deg); }
  @keyframes starTwinkle { 0% { opacity: 0.2; } 100% { opacity: 0.6; } }

  .playground-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 2; }

  /* --- 2. HERO --- */
  .playground-hero { text-align: center; margin-bottom: 5rem; display: flex; flex-direction: column; align-items: center; }
  .hero-badge { display: inline-flex; align-items: center; gap: 8px; font-family: 'SF Mono', monospace; font-size: 0.85rem; font-weight: 700; color: #a1a1aa; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 8px 16px; border-radius: 100px; margin-bottom: 1.5rem; letter-spacing: 0.05em; }
  .hero-badge svg { width: 16px; height: 16px; }
  .hero-title { font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 900; line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 1.5rem; color: #fff; }
  .text-gradient { background: linear-gradient(135deg, #fff 20%, #a1a1aa 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .hero-subtitle { font-size: 1.15rem; color: #a1a1aa; max-width: 650px; line-height: 1.6; }

  /* --- 3. OTOMATİK OYNATILAN İNTERAKTİF REHBER --- */
  .interactive-guide { display: grid; grid-template-columns: 1fr 1.3fr; gap: 5rem; align-items: center; margin-bottom: 6rem; }
  .guide-nav { display: flex; flex-direction: column; gap: 1rem; }
  
  .step-trigger {
    position: relative; display: flex; align-items: center; gap: 20px; width: 100%; text-align: left;
    background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); padding: 24px; border-radius: 20px;
    cursor: pointer; transition: all 0.3s ease; overflow: hidden;
  }
  .step-trigger:hover { background: rgba(255,255,255,0.05); }
  .step-trigger.active { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.2); transform: translateX(10px); }
  
  .step-indicator { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 12px; background: rgba(255,255,255,0.05); color: #71717a; transition: all 0.3s; }
  .step-indicator svg { width: 24px; height: 24px; }
  .step-trigger.active .step-indicator { background: #fff; color: #000; box-shadow: 0 0 15px rgba(255,255,255,0.2); }

  .step-content h3 { font-size: 1.25rem; font-weight: 700; color: #a1a1aa; margin-bottom: 4px; transition: color 0.3s; }
  .step-content p { font-size: 0.95rem; color: #52525b; margin: 0; transition: color 0.3s; }
  .step-trigger.active .step-content h3 { color: #fff; }
  .step-trigger.active .step-content p { color: #d4d4d8; }

  /* İlerleme Çubuğu */
  .progress-track { position: absolute; bottom: 0; left: 0; width: 100%; height: 3px; background: transparent; }
  .progress-fill { width: 100%; height: 100%; background: #fff; transform-origin: left; transform: scaleX(0); }
  .step-trigger.active .progress-fill { animation: fillBar 5s linear forwards; }
  @keyframes fillBar { to { transform: scaleX(1); } }

  /* Sağ Taraf - Cam Panel (Mockup) */
  .guide-visual-wrapper { perspective: 1000px; width: 100%; }
  .glass-panel {
    position: relative; width: 100%; aspect-ratio: 4/3; border-radius: 24px; overflow: hidden;
    background: rgba(9, 9, 11, 0.8); border: 1px solid rgba(255,255,255,0.1); 
    box-shadow: 0 20px 50px rgba(0,0,0,0.6); backdrop-filter: blur(20px); transform-style: preserve-3d;
  }
  
  .hardware-glow { position: absolute; left: 0; top: 0; width: 300px; height: 300px; margin-left: -150px; margin-top: -150px; background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%); border-radius: 50%; pointer-events: none; opacity: 0; transition: opacity 0.3s; z-index: 1; will-change: transform; }
  .glass-panel:hover .hardware-glow { opacity: 1; }

  .visual-layer { position: absolute; inset: 0; opacity: 0; visibility: hidden; transform: scale(0.98); transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1); z-index: 2; }
  .visual-layer.active { opacity: 1; visibility: visible; transform: scale(1); }

  .mockup-window { width: 100%; height: 100%; display: flex; flex-direction: column; }
  .m-header { height: 40px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; align-items: center; padding: 0 16px; gap: 8px; background: rgba(0,0,0,0.3); }
  .dot { width: 12px; height: 12px; border-radius: 50%; }
  .dot.r { background: #ff5f56; } .dot.y { background: #ffbd2e; } .dot.g { background: #27c93f; }
  .m-body { flex: 1; position: relative; overflow: hidden; background: #000; }
  .flex-center { display: flex; align-items: center; justify-content: center; height: 100%; }
  .flex-column { flex-direction: column; }

  /* --- ADIM 1: APPLE TARZI İNDİRME HALKASI --- */
  .apple-dl-ui { display: flex; flex-direction: column; align-items: center; gap: 24px; }
  .dl-circle-wrap { position: relative; width: 80px; height: 80px; }
  .dl-svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .dl-bg { fill: none; stroke: rgba(255,255,255,0.1); stroke-width: 4; }
  .dl-progress { fill: none; stroke: #fff; stroke-width: 4; stroke-linecap: round; stroke-dasharray: 290; stroke-dashoffset: 290; transition: stroke-dashoffset 4.5s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .visual-layer.active .dl-progress { stroke-dashoffset: 0; }
  .dl-icon-center { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #fff; }
  .dl-icon-center svg { width: 28px; height: 28px; animation: subtleBounce 2s infinite alternate ease-in-out; }
  .apple-dl-text { font-size: 0.95rem; color: #a1a1aa; font-weight: 500; }
  @keyframes subtleBounce { 0% { transform: translateY(-3px); } 100% { transform: translateY(3px); } }

  /* --- ADIM 2: APPLE TARZI KÜTÜPHANE TARAMA (Radar İptal, Cam Geçişi) --- */
  .apple-scan-grid { display: flex; gap: 24px; position: relative; padding: 40px; }
  .scan-card { width: 70px; height: 100px; border-radius: 12px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); position: relative; overflow: hidden; transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
  
  /* Tarama esnasında kapakların aydınlanması */
  .visual-layer.active .sc-1 { background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.3); transform: translateY(-8px); transition-delay: 0.8s; box-shadow: 0 10px 20px rgba(255,255,255,0.1); }
  .visual-layer.active .sc-2 { background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.3); transform: translateY(-8px); transition-delay: 1.6s; box-shadow: 0 10px 20px rgba(255,255,255,0.1); }
  .visual-layer.active .sc-3 { background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.3); transform: translateY(-8px); transition-delay: 2.4s; box-shadow: 0 10px 20px rgba(255,255,255,0.1); }
