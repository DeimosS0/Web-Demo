---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  isHomepage?: boolean;
  structuredData?: Record<string, unknown>[];
}

const siteUrl = 'https://makineceviri.net';

const {
  title = 'Makine Çeviri — Oyun Türkçe Yama ve Çeviri Topluluğu',
  description = 'Oyunlarını Türkçe oyna. 250+ oyun için Türkçe yama ve çeviri. MakineAI ile tek tıkla Türkçe yama kur. Steam, Epic Games, GOG destekli. Ücretsiz.',
  canonical = siteUrl,
  ogImage = `${siteUrl}/images/og-image.png`,
  isHomepage = false,
  structuredData = [],
} = Astro.props;

const keywords = 'türkçe yama, oyun türkçe yama, oyun çeviri, türkçe çeviri, oyun yaması, türkçe yama indir, oyun türkçeleştirme, makine çeviri, makineai, steam türkçe yama, epic games türkçe, oyun dil yaması, türkçe dil paketi, oyun yerelleştirme, türkçe oyun';
---

<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="Makine Çeviri" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="tr" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Makine Çeviri — Türkçe oyun yaması topluluğu" />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:site_name" content="Makine Çeviri" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <meta name="theme-color" content="#07070a" />
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="apple-touch-icon" href="/images/logo.png" />
  <link rel="manifest" href="/manifest.json" />

  <!-- Self-hosted Inter font preloads (most used weight first) -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-400-latin.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-600-latin.woff2" crossorigin />

  <!-- Structured Data: Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Makine Çeviri",
    "url": siteUrl,
    "logo": `${siteUrl}/images/logo.png`,
    "description": "Yapay zekâ destekli oyun yerelleştirme topluluğu. Türkçe oyun çevirileri ve yamaları.",
    "sameAs": [
      "https://github.com/MakineCeviri",
      "https://discord.com/invite/QDezpy4QtV",
      "https://www.linkedin.com/company/makineceviri"
    ]
  })} />

  {isHomepage && (<Fragment>
  <!-- Structured Data: Software Application -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "MakineAI",
    "operatingSystem": "Windows 10, Windows 11",
    "applicationCategory": "UtilitiesApplication",
    "description": "Oyunlar için Türkçe yama ve çeviri yöneticisi. Steam, Epic Games ve GOG oyunlarına tek tıkla Türkçe yama kurun.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "TRY"
    },
    "downloadUrl": `${siteUrl}/download`,
    "author": {
      "@type": "Organization",
      "name": "Makine Çeviri"
    }
  })} />

  <!-- Structured Data: FAQ (Google Rich Snippets) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "MakineAI nedir?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "MakineAI, bilgisayarınızdaki oyunları otomatik tespit edip Türkçe yama kurmanızı sağlayan ücretsiz bir masaüstü uygulamasıdır. Steam, Epic Games ve GOG kütüphanelerini destekler."
        }
      },
      {
        "@type": "Question",
        "name": "Türkçe yama nasıl kurulur?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "MakineAI'yı indirin, çalıştırın. Uygulama oyunlarınızı otomatik bulacaktır. Türkçe çevirisi olan oyunun yanındaki Kur butonuna tıklayın. Yama otomatik indirilip kurulacaktır."
        }
      },
      {
        "@type": "Question",
        "name": "Hangi oyunlar destekleniyor?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "250'den fazla oyun için Türkçe yama ve çeviri bulunmaktadır. Katalog sürekli büyümektedir. Steam, Epic Games Store ve GOG üzerindeki oyunlar desteklenir."
        }
      },
      {
        "@type": "Question",
        "name": "MakineAI ücretsiz mi?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Evet, MakineAI tamamen ücretsizdir. Topluluk tarafından, topluluk için geliştirilmektedir. Hiçbir ücret veya abonelik gerektirmez."
        }
      },
      {
        "@type": "Question",
        "name": "Türkçe yama güvenli mi?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Evet. Tüm yamalar AES-256 şifreleme ve SHA-256 doğrulama ile korunur. Her kurulum öncesi orijinal dosyalarınız otomatik yedeklenir."
        }
      },
      {
        "@type": "Question",
        "name": "Oyun güncellenince Türkçe yama bozulur mu?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "MakineAI akıllı güncelleme sistemi sayesinde oyun güncellendiğinde yamalar otomatik uyarlanır. Manuel işlem yapmanıza gerek kalmaz."
        }
      }
    ]
  })} />

  <!-- Structured Data: WebSite (Search Box) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Makine Çeviri",
    "url": siteUrl,
    "inLanguage": "tr"
  })} />
  </Fragment>)}

  {structuredData.map((data) => (
    <script type="application/ld+json" set:html={JSON.stringify(data)} />
  ))}


  <title>{title}</title>
</head>
<body>
  <!-- Squircle clip-path -->
  <svg width="0" height="0" style="position: absolute;">
    <defs>
      <clipPath id="squircleClip" clipPathUnits="objectBoundingBox">
        <path d="M 0,0.5 C 0,0 0,0 0.5,0 S 1,0 1,0.5 1,1 0.5,1 0,1 0,0.5"></path>
      </clipPath>
    </defs>
  </svg>

  <main>
    <slot />
  </main>

  <script>
    const navbar = document.querySelector('.navbar');
    if (navbar) {
      window.addEventListener('scroll', () => {
        navbar.classList.toggle('scrolled', window.scrollY > 20);
      });
    }

    const menuBtn = document.querySelector('.mobile-menu-btn');
    const navLinks = document.querySelector('.nav-links');
    if (menuBtn && navLinks) {
      menuBtn.addEventListener('click', () => {
        navLinks.classList.toggle('active');
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    document.querySelectorAll('.animate-on-scroll').forEach((el) => {
      observer.observe(el);
    });

    // Hide loading screen after page is ready
    const loader = document.getElementById('loading-screen');
    if (loader) {
      window.addEventListener('load', () => {
        setTimeout(() => loader.classList.add('hidden'), 200);
      });
    }
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
