---
---

<section id="ozellikler" class="features-section">
  <div class="bg-typography" id="bg-type">MAKINE.AI_ENGINE</div>

  <div class="features-container">
    
    <div class="section-header">
      <h2 class="section-title reveal-trigger">
        Sıradan Bir Yama Değil, <br/>
        <span class="metallic-text" data-text="Kusursuz Bir Ekosistem.">Kusursuz Bir Ekosistem.</span>
      </h2>
      <p class="section-subtitle reveal-trigger">
        Oyun içi dosyaları bozmadan, sistem performansını etkilemeden çalışan yeni nesil sinir ağı mimarisi.
      </p>
    </div>

    <div class="bento-grid" id="features-grid">
      
      <div class="bento-card wide-card dl-card scroll-3d-card">
        <div class="card-content dl-content">
          <div class="text-zone">
            <div class="icon-wrapper">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
                <rect x="9" y="9" width="6" height="6"></rect>
                <line x1="9" y1="1" x2="9" y2="4"></line>
                <line x1="15" y1="1" x2="15" y2="4"></line>
                <line x1="9" y1="20" x2="9" y2="23"></line>
                <line x1="15" y1="20" x2="15" y2="23"></line>
                <line x1="20" y1="9" x2="23" y2="9"></line>
                <line x1="20" y1="14" x2="23" y2="14"></line>
                <line x1="1" y1="9" x2="4" y2="9"></line>
                <line x1="1" y1="14" x2="4" y2="14"></line>
              </svg>
            </div>
            <h3 class="card-title">Derin Öğrenme <br/>Destekli Çeviri</h3>
            <p class="card-text">
              Robotik çevirileri unutun. MakineAI, karakterlerin duygularını ve oyun evreninin jargonunu analiz ederek bağlama uygun çeviriler üretir.
            </p>
          </div>
          <div class="visual-zone">
            <div class="translation-sim">
              <div class="lang-box en-box">
                <span class="lang-tag">ENG</span>
                <p>"I used to be an adventurer like you..."</p>
              </div>
              <div class="ai-processing-line">
                <div class="scanner-dot"></div>
              </div>
              <div class="lang-box tr-box">
                <span class="lang-tag">TR</span>
                <p>"Ben de senin gibi bir maceracıydım..."</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="bento-card square-card perf-card scroll-3d-card" style="transition-delay: 0.1s;">
        <div class="card-content">
          <div class="icon-wrapper">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <h3 class="card-title">Sıfır FPS Kaybı</h3>
          <p class="card-text">Sistem kaynaklarını minimumda tutan bypass mimarisi.</p>
          
          <div class="perf-gauge">
            <svg viewBox="0 0 100 50" class="gauge-svg">
              <path d="M 10 50 A 40 40 0 0 1 90 50" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="8" stroke-linecap="round"/>
              <path class="gauge-fill" d="M 10 50 A 40 40 0 0 1 90 50" fill="none" stroke="#4ecdc4" stroke-width="8" stroke-linecap="round" stroke-dasharray="126" stroke-dashoffset="126"/>
            </svg>
            <div class="gauge-text">%0.1<span>CPU Tüketimi</span></div>
          </div>
        </div>
      </div>

      <div class="bento-card square-card lib-card scroll-3d-card" style="transition-delay: 0.1s;">
        <div class="card-content">
          <div class="icon-wrapper">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="6" y1="12" x2="10" y2="12"></line>
              <line x1="8" y1="10" x2="8" y2="14"></line>
              <line x1="15" y1="13" x2="15.01" y2="13"></line>
              <line x1="18" y1="11" x2="18.01" y2="11"></line>
              <rect x="2" y="6" width="20" height="12" rx="2"></rect>
            </svg>
          </div>
          <h3 class="card-title">Geniş Kütüphane</h3>
          <p class="card-text">250'den fazla oyun desteği ve her gün güncellenen bulut altyapısı.</p>
          <div class="marquee-container">
            <div class="marquee-content">
              <span>Starfield</span><span class="dot">•</span>
              <span>Wuthering Waves</span><span class="dot">•</span>
              <span>Assassin's Creed Valhalla</span><span class="dot">•</span>
              <span>RDR2</span><span class="dot">•</span>
              <span>Elden Ring</span><span class="dot">•</span>
              <span>Cyberpunk</span><span class="dot">•</span>
              <span>Assassin's Creed Valhalla</span><span class="dot">•</span>
            </div>
          </div>
        </div>
      </div>

      <div class="bento-card wide-card install-card scroll-3d-card">
        <div class="card-content dl-content reverse-layout">
          <div class="text-zone">
            <div class="icon-wrapper">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72Z"/>
                <path d="m14 7 3 3"/>
                <path d="M5 6v4"/>
                <path d="M19 14v4"/>
                <path d="M10 2v2"/>
                <path d="M7 8H3"/>
                <path d="M21 16h-4"/>
                <path d="M11 3H9"/>
              </svg>
            </div>
            <h3 class="card-title">Dosya Karmaşasına Son</h3>
            <p class="card-text">
              Oyun dizinini bulmak veya ".ini" dosyalarını düzenlemek yok. Sistem oyununuzu tespit eder ve tek tıkla çeviriyi entegre eder.
            </p>
          </div>
          <div class="visual-zone">
            <div class="code-terminal">
              <div class="c-head"><span></span><span></span><span></span></div>
              <div class="c-body">
                <div class="c-line">> Scanning directories...</div>
                <div class="c-line">> Game path found: C:\Games\Starfield</div>
                <div class="c-line success">> Injection successful.</div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Temel Alan */
  .features-section {
    position: relative; padding: 160px 20px;
    background: #050507; z-index: 10; overflow: hidden;
  }

  .features-container { max-width: 1100px; margin: 0 auto; position: relative; z-index: 2; }

  /* Scroll ile hareket eden arka plan yazısı */
  .bg-typography {
    position: absolute; top: 10%; left: -10%; white-space: nowrap;
    font-size: 15vw; font-weight: 900; color: rgba(255, 255, 255, 0.015);
    z-index: 0; pointer-events: none; transform: translateY(0);
    font-family: 'SF Mono', 'Fira Code', monospace;
  }

  /* Yenilenmiş Başlıklar (Gradyan yok, temiz, keskin) */
  .section-header { text-align: center; margin-bottom: 6rem; perspective: 1000px; }
  
  .section-title {
    font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 700; color: #fff;
    line-height: 1.1; margin-bottom: 1.5rem; letter-spacing: -0.04em;
  }

  .metallic-text {
    position: relative; display: inline-block; color: #a1a1aa; 
  }
  .metallic-text::after {
    content: attr(data-text); position: absolute; left: 0; top: 0;
    background: linear-gradient(110deg, transparent 20%, #fff 40%, #fff 60%, transparent 80%);
    background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    animation: metallicShine 4s linear infinite;
  }
  @keyframes metallicShine { 0% { background-position: 200% 50%; } 100% { background-position: -200% 50%; } }

  .section-subtitle { font-size: 1.15rem; color: #71717a; max-width: 500px; margin: 0 auto; line-height: 1.6; }

  /* Asimetrik Bento Grid Düzeni (Çapraz 2x2) */
  .bento-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;
    grid-auto-rows: minmax(320px, auto);
  }

  .dl-card { grid-column: span 2; }
  .perf-card { grid-column: span 1; }
  .lib-card { grid-column: span 1; }
  .install-card { grid-column: span 2; }

  /* Saf, Camımsı Kart Tasarımı */
  .bento-card {
    position: relative; background: rgba(24, 24, 27, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 24px; overflow: hidden;
    backdrop-filter: blur(20px); transition: border-color 0.4s ease;
  }
  .bento-card:hover { border-color: rgba(255, 255, 255, 0.15); }

  .card-content { display: flex; flex-direction: column; height: 100%; padding: 2.5rem; position: relative; z-index: 2; }
  
  .icon-wrapper {
    width: 44px; height: 44px; border-radius: 10px; background: #18181b; border: 1px solid #27272a;
    display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; color: #e4e4e7;
  }
  .icon-wrapper svg { width: 22px; height: 22px; }

  .card-title { font-size: 1.4rem; font-weight: 600; color: #fafafa; margin-bottom: 0.75rem; letter-spacing: -0.02em; }
  .card-text { font-size: 0.95rem; color: #a1a1aa; line-height: 1.6; }

  .dl-content { flex-direction: row; align-items: center; justify-content: space-between; gap: 2rem; padding: 2rem 2.5rem; }
  .reverse-layout { flex-direction: row-reverse; }
  .text-zone { flex: 1; max-width: 280px; }
  .visual-zone { flex: 1.5; height: 100%; display: flex; align-items: center; justify-content: center; position: relative; }

  /* --- Kart İçi Animasyonlar & İzahlar (UX) --- */

  /* 1. DL Çeviri Simülasyonu */
  .translation-sim { width: 100%; display: flex; flex-direction: column; gap: 15px; }
  .lang-box { background: #09090b; border: 1px solid #27272a; padding: 1rem; border-radius: 12px; position: relative; }
  .lang-tag { position: absolute; top: -10px; left: 15px; background: #18181b; padding: 2px 8px; font-size: 0.7rem; color: #71717a; border: 1px solid #27272a; border-radius: 4px; font-family: monospace; }
  .lang-box p { margin: 0; font-size: 0.85rem; color: #e4e4e7; font-family: monospace; }
  .tr-box p { color: #4ecdc4; } 
  .ai-processing-line { height: 2px; background: #27272a; width: 80%; margin: 0 auto; position: relative; overflow: hidden; }
  .scanner-dot { position: absolute; top: 0; left: 0; height: 100%; width: 30%; background: linear-gradient(90deg, transparent, #4ecdc4, transparent); animation: scanLine 2s ease-in-out infinite; }
  @keyframes scanLine { 0% { left: -30%; } 100% { left: 100%; } }

  /* 2. DÜZELTİLMİŞ Performans Göstergesi */
  .perf-gauge { 
    position: relative; display: flex; justify-content: center; 
    margin-top: auto; padding-top: 2rem; 
  }
  .gauge-svg { width: 150px; overflow: visible; display: block; }
  
  /* Metin artık tam olarak yarım dairenin ortasına, alt hizaya oturur */
  .gauge-text { 
    position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); 
    text-align: center; font-size: 1.6rem; font-weight: 800; color: #fff; line-height: 1; 
  }
  .gauge-text span { 
    display: block; font-size: 0.7rem; font-weight: 500; color: #71717a; 
    text-transform: uppercase; margin-top: 6px; letter-spacing: 0.05em; 
  }
  
  .perf-card.is-visible .gauge-fill { transition: stroke-dashoffset 2s cubic-bezier(0.2, 1, 0.3, 1) 0.5s; stroke-dashoffset: 0; }

  /* 3. Kütüphane Marquee */
  .marquee-container { margin-top: auto; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent); padding-top: 2rem; }
  .marquee-content { display: flex; gap: 15px; white-space: nowrap; animation: scrollMarquee 15s linear infinite; font-family: monospace; color: #a1a1aa; font-size: 0.9rem; }
  .marquee-content .dot { color: #3f3f46; }
  @keyframes scrollMarquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

  /* 4. Kurulum Terminali */
  .code-terminal { background: #000; border: 1px solid #27272a; border-radius: 8px; width: 100%; padding: 1rem; font-family: monospace; font-size: 0.8rem; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
  .c-head { display: flex; gap: 6px; margin-bottom: 15px; }
  .c-head span { width: 10px; height: 10px; border-radius: 50%; background: #3f3f46; }
  .c-line { color: #71717a; margin-bottom: 6px; opacity: 0; transform: translateY(5px); }
  .c-line.success { color: #4ecdc4; }
  
  .install-card.is-visible .c-line:nth-child(1) { animation: terminalFade 0.1s forwards 0.5s; }
  .install-card.is-visible .c-line:nth-child(2) { animation: terminalFade 0.1s forwards 1.2s; }
  .install-card.is-visible .c-line:nth-child(3) { animation: terminalFade 0.1s forwards 2s; }
  @keyframes terminalFade { to { opacity: 1; transform: translateY(0); } }

  /* --- MÜKEMMEL SCROLL 3D ANİMASYONLARI --- */
  .scroll-3d-card {
    opacity: 0;
    transform: translateY(80px) translateZ(-100px) rotateX(15deg);
    transition: opacity 0.8s ease-out, transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    transform-style: preserve-3d;
  }
  
  .scroll-3d-card.is-visible {
    opacity: 1;
    transform: translateY(0) translateZ(0) rotateX(0deg);
  }

  .reveal-trigger {
    opacity: 0; transform: translateY(30px); filter: blur(10px);
    transition: opacity 0.8s, transform 0.8s, filter 0.8s;
  }
  .reveal-trigger.is-visible { opacity: 1; transform: translateY(0); filter: blur(0); }

  /* Mobil Uyumluluk */
  @media (max-width: 992px) {
    .dl-card, .install-card { grid-column: span 3; }
    .perf-card, .lib-card { grid-column: span 3; }
    .dl-content { flex-direction: column; align-items: flex-start; }
    .text-zone { max-width: 100%; }
    .visual-zone { width: 100%; margin-top: 2rem; }
  }
</style>

<script>
  // --- 1. Mükemmel Scroll & 3D Unfold Animasyonları ---
  const setupScrollAnimations = () => {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.15 
    };

    const scrollObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          scrollObserver.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('.reveal-trigger, .scroll-3d-card').forEach((el) => {
      scrollObserver.observe(el);
    });
  };

  // --- 2. Parallax Arka Plan Tipografisi ---
  const setupParallax = () => {
    const bgType = document.getElementById('bg-type');
    
    window.addEventListener('scroll', () => {
      if (!bgType) return;
      const scrolled = window.scrollY;
      bgType.style.transform = `translateY(${scrolled * 0.3}px)`;
    });
  };

  document.addEventListener('DOMContentLoaded', () => {
    setupScrollAnimations();
    setupParallax();
  });
</script>