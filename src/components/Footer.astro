          <li><a href="#">Kullanım Koşulları</a></li>
          <li><a href="#">İletişim</a></li>
        </ul>
      </div>

    </div>

    <div class="footer-bottom-row">
      <div class="copyright-text">
        &copy; {currentYear} Makine Çeviri. Tüm hakları saklıdır.
