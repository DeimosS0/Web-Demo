---
const currentYear = new Date().getFullYear();
---

<footer class="cyber-footer">
  <div class="footer-laser-top">
    <div class="laser-flare"></div>
  </div>

  <div class="footer-grid"></div>

  <div class="footer-container">
    <div class="footer-content">
      
      <div class="footer-brand">
        <a href="/" class="f-logo">
          <img src="/images/logo.png" alt="MakineAI Logo" />
          <span class="logo-text">MAKINE<span class="cyan">.AI</span></span>
        </a>
        <p class="brand-desc">
          Oyun dünyasındaki dil sınırlarını yapay zeka ve sinir ağları ile yıkan, sıfır performans kayıplı yeni nesil çeviri motoru.
        </p>
        
        <div class="premium-status">
          <div class="status-icon">
            <svg class="spin-ring" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10" stroke-dasharray="12 12" stroke-linecap="round"/>
            </svg>
            <span class="core-dot"></span>
          </div>
          <div class="status-texts">
            <span class="s-label">AĞ TELEMETRİSİ</span>
            <span class="s-value">BÜTÜN DÜĞÜMLER AKTİF<span class="blinking-cursor">_</span></span>
          </div>
          <div class="status-graph">
             <span class="bar b1"></span>
             <span class="bar b2"></span>
             <span class="bar b3"></span>
             <span class="bar b4"></span>
          </div>
        </div>
      </div>

      <div class="footer-links-wrapper">
        <div class="link-column">
          <h4 class="col-title">VERİTABANI</h4>
          <nav class="f-nav">
            <a href="/" class="f-link"><span class="arr">></span> Ana Sistem</a>
            <a href="/oyunlar" class="f-link"><span class="arr">></span> Desteklenen Oyunlar</a>
            <a href="/rehber" class="f-link"><span class="arr">></span> Kurulum Protokolü</a>
            <a href="/#indir" class="f-link highlight"><span class="arr">></span> Motoru İndir</a>
          </nav>
        </div>

        <div class="link-column">
          <h4 class="col-title">BAĞLANTILAR</h4>
          <nav class="f-nav">
            <a href="/iletisim" class="f-link"><span class="arr">></span> Ağ Geçidi (İletişim)</a>
            <a href="#" class="f-link"><span class="arr">></span> Topluluk Discord'u</a>
            <a href="#" class="f-link"><span class="arr">></span> GitHub Repoları</a>
            <a href="#" class="f-link"><span class="arr">></span> Gizlilik Sözleşmesi</a>
          </nav>
        </div>
      </div>

    </div>

    <div class="footer-bottom">
      <div class="copyright">
        &copy; {currentYear} MAKINE.AI_ENGINE. Tüm hakları ve verileri şifrelenmiştir.
      </div>
      <div class="signature">
        <span class="tech-tag">Powered by Deep Learning</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .cyber-footer {
    position: relative; background: #020203; 
    border-top: 1px solid rgba(255, 255, 255, 0.02); overflow: hidden;
    padding-top: 5rem; z-index: 10;
  }

  /* Üstten Akan Neon Lazer */
  .footer-laser-top {
    position: absolute; top: 0; left: 0; width: 100%; height: 1px;
    background: rgba(78, 205, 196, 0.15);
  }
  .laser-flare {
    position: absolute; top: -1px; left: -100px; width: 200px; height: 3px;
    background: linear-gradient(90deg, transparent, #4ecdc4, #d4a843, transparent);
    box-shadow: 0 0 15px #4ecdc4; animation: laserScan 6s ease-in-out infinite;
  }
  @keyframes laserScan { 0% { left: -200px; } 100% { left: 100%; } }

  /* Zemin Grid'i */
  .footer-grid {
    position: absolute; inset: 0; z-index: 0; opacity: 0.3;
    background-size: 30px 30px;
    background-image: linear-gradient(to right, rgba(255,255,255,0.02) 1px, transparent 1px),
                      linear-gradient(to bottom, rgba(255,255,255,0.02) 1px, transparent 1px);
    mask-image: linear-gradient(to bottom, black 0%, transparent 80%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 80%);
  }

  .footer-container {
    max-width: 1200px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 2;
  }

  .footer-content {
    display: flex; justify-content: space-between; gap: 4rem; margin-bottom: 4rem;
  }

  /* Sol: Marka */
  .footer-brand { flex: 1.5; max-width: 400px; }
  
  .f-logo { display: flex; align-items: center; gap: 12px; text-decoration: none; margin-bottom: 1.5rem; }
  .f-logo img { height: 40px; width: auto; filter: drop-shadow(0 0 10px rgba(78,205,196,0.2)); transition: transform 0.3s; }
  .f-logo:hover img { transform: scale(1.05) rotate(5deg); }
  .logo-text { font-size: 1.5rem; font-weight: 800; color: #fff; letter-spacing: 0.05em; font-family: 'SF Mono', monospace; }
  .logo-text .cyan { color: #4ecdc4; }

  .brand-desc { font-size: 0.95rem; color: #71717a; line-height: 1.7; margin-bottom: 2rem; }

  /* --- Zarif Canlı Telemetri Paneli --- */
  .premium-status {
    display: inline-flex; align-items: center; gap: 14px;
    padding: 8px 24px 8px 12px;
    background: rgba(16, 185, 129, 0.04); 
    border: 1px solid rgba(16, 185, 129, 0.15);
    border-radius: 100px; /* Tam yuvarlak kapsül */
    backdrop-filter: blur(10px);
    box-shadow: inset 0 0 20px rgba(16, 185, 129, 0.02);
    transition: background 0.3s, border-color 0.3s;
  }
  .premium-status:hover {
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.3);
  }

  .status-icon {
    position: relative; width: 26px; height: 26px;
    display: flex; align-items: center; justify-content: center;
  }
  .spin-ring {
    position: absolute; inset: 0; color: #10b981; opacity: 0.6;
    animation: spinSlow 6s linear infinite;
  }
  .core-dot {
    width: 6px; height: 6px; background: #10b981; border-radius: 50%;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.8);
    animation: pulseGlow 2s ease-in-out infinite alternate;
  }

  .status-texts {
    display: flex; flex-direction: column; justify-content: center; gap: 2px;
  }
  .s-label { 
    font-size: 0.65rem; color: #71717a; letter-spacing: 0.15em; 
    font-family: 'SF Mono', 'Fira Code', monospace; 
  }
  .s-value { 
    font-size: 0.75rem; font-weight: 700; color: #10b981; 
    letter-spacing: 0.05em; font-family: 'SF Mono', 'Fira Code', monospace; 
    display: flex; align-items: center; 
  }
  .blinking-cursor { 
    display: inline-block; width: 6px; height: 12px; background: #10b981; 
    margin-left: 4px; animation: blink 1s step-end infinite; 
  }

  /* Mini Veri Grafiği (Equalizer) */
  .status-graph { 
    display: flex; align-items: flex-end; gap: 3px; 
    height: 14px; margin-left: 8px; opacity: 0.6; 
  }
  .bar { width: 2px; background: #10b981; border-radius: 1px; }
  .b1 { height: 40%; animation: eq 1s ease-in-out infinite alternate; }
  .b2 { height: 80%; animation: eq 1.2s ease-in-out infinite alternate-reverse; }
  .b3 { height: 60%; animation: eq 0.8s ease-in-out infinite alternate; }
  .b4 { height: 100%; animation: eq 1.5s ease-in-out infinite alternate-reverse; }

  @keyframes spinSlow { 100% { transform: rotate(360deg); } }
  @keyframes pulseGlow { 
    0% { box-shadow: 0 0 5px rgba(16,185,129,0.5); transform: scale(0.9); } 
    100% { box-shadow: 0 0 15px rgba(16,185,129,1); transform: scale(1.1); } 
  }
  @keyframes eq { 0% { height: 30%; } 100% { height: 100%; } }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  /* Orta: Linkler */
  .footer-links-wrapper { flex: 2; display: flex; gap: 4rem; justify-content: flex-end; }
  .link-column { min-width: 150px; }
  
  .col-title { font-size: 0.85rem; font-weight: 700; color: #fff; letter-spacing: 0.1em; margin-bottom: 1.5rem; font-family: 'SF Mono', monospace; }
  
  .f-nav { display: flex; flex-direction: column; gap: 12px; }
  .f-link { 
    font-size: 0.95rem; color: #a1a1aa; text-decoration: none; transition: all 0.2s;
    display: flex; align-items: center; gap: 8px;
  }
  .f-link .arr { color: #3f3f46; font-family: monospace; font-size: 0.8rem; transition: color 0.2s, transform 0.2s; }
  
  .f-link:hover { color: #fff; transform: translateX(5px); }
  .f-link:hover .arr { color: #4ecdc4; transform: translateX(3px); }
  .f-link.highlight { color: #4ecdc4; font-weight: 500; }
  .f-link.highlight .arr { color: #d4a843; }

  /* Alt: İmza */
  .footer-bottom {
    display: flex; justify-content: space-between; align-items: center;
    padding: 24px 0; border-top: 1px dashed rgba(255, 255, 255, 0.05);
  }
  .copyright { font-size: 0.8rem; color: #71717a; font-family: 'SF Mono', monospace; }
  
  .signature { display: flex; align-items: center; gap: 10px; }
  .tech-tag {
    font-size: 0.75rem; color: #d4a843; border: 1px solid rgba(212, 168, 67, 0.2);
    padding: 4px 10px; border-radius: 6px; background: rgba(212, 168, 67, 0.05);
    font-family: 'SF Mono', monospace;
  }

  @media (max-width: 768px) {
    .footer-content { flex-direction: column; gap: 3rem; }
    .footer-brand { max-width: 100%; }
    .footer-links-wrapper { flex-direction: column; gap: 2.5rem; justify-content: flex-start; }
    .footer-bottom { flex-direction: column; gap: 1rem; text-align: center; }
  }
</style>