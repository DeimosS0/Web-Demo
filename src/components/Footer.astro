<style>
  /* --- GENEL FOOTER YAPISI --- */
  .spacious-footer {
    background: #09090b;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 6rem 0 3rem;
    color: #a1a1aa;
    font-family: inherit;
    margin-top: auto;
  }

  .footer-wrapper {
    max-width: 1400px; 
    margin: 0 auto;
    padding: 0 40px; 
  }

  /* --- ÜST BÖLÜM (IZGARA) --- */
  .footer-top-grid {
    display: grid;
    grid-template-columns: minmax(300px, 2fr) repeat(3, 1fr);
    gap: 6rem; 
    margin-bottom: 5rem;
  }

  /* Marka Alanı */
  .brand-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* TİPOGRAFİK LOGO: Sadece metin ama çok güçlü ve tok */
  .brand-logo {
    font-size: 1.6rem;
    font-weight: 800;
    color: #fff;
    text-decoration: none;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
    transition: color 0.2s;
  }
  .brand-logo:hover {
    color: #e4e4e7;
  }

  .brand-desc {
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
    max-width: 380px;
    color: #71717a; 
  }

  /* Link Sütunları */
  .links-column {
    display: flex;
    flex-direction: column;
  }
  
  .col-heading {
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    margin: 0 0 1.5rem 0;
    letter-spacing: 0.02em;
  }

  .clean-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px; 
  }

  .clean-list a {
    color: #a1a1aa;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  .clean-list a:hover {
    color: #fff;
  }

  /* --- ALT BÖLÜM (YASAL & SOSYAL) --- */
  .footer-bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .copyright-text {
    font-size: 0.9rem;
    color: #71717a;
    margin: 0;
  }

  /* Sosyal İkonlar */
  .social-flex {
    display: flex;
    gap: 20px;
  }
  
  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #71717a;
    transition: color 0.2s, transform 0.2s;
  }
  .social-btn svg {
    width: 22px;
    height: 22px;
  }
  .social-btn:hover {
    color: #fff;
    transform: translateY(-2px);
  }

  /* --- RESPONSIVE TASARIM --- */
  @media (max-width: 1024px) {
    .footer-top-grid {
      grid-template-columns: 1fr 1fr; 
      gap: 4rem;
    }
    .brand-column {
      grid-column: span 2; 
      max-width: 100%;
    }
    .brand-desc {
      max-width: 600px;
    }
  }

  @media (max-width: 640px) {
    .spacious-footer {
      padding: 4rem 0 2rem;
    }
    .footer-wrapper {
      padding: 0 24px;
    }
    .footer-top-grid {
      grid-template-columns: 1fr; 
      gap: 3rem;
    }
    .brand-column {
      grid-column: span 1;
    }
    .footer-bottom-row {
      flex-direction: column-reverse; 
      gap: 2rem;
      text-align: center;
    }
  }
</style>