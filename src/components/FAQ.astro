---
const faqs = [
  {
    id: "01",
    q: "Oyunlarda ban sebebi mi? Risk var mı?",
    a: "MakineAI, oyun dosyalarına müdahale etmeyen (memory-bypass) bir mimari kullanır. Hikayeli ve tek oyunculu oyunlarda ban riski %0'dır. Rekabetçi (Anti-Cheat korumalı) oyunlarda ise motor kendini güvenlik amacıyla otomatik olarak askıya alır."
  },
  {
    id: "02",
    q: "Çeviri sırasında FPS kaybı yaşar mıyım?",
    a: "Sistem kaynaklarınızı korumak ana önceliğimizdir. Çeviri işlemleri ekran kartınızı (GPU) yormaz. İşlemci (CPU) tüketimi ise optimize edilmiş C++ altyapımız sayesinde %0.1 ile %0.5 arasındadır. Oyun performansınız etkilenmez."
  },
  {
    id: "03",
    q: "İnternet bağlantısı zorunlu mu?",
    a: "Evet. MakineAI'nin sinir ağı çeviri modelleri devasa boyutlardadır ve yerel bir bilgisayarda çalıştırılamaz. Bu yüzden anlık ve kusursuz çeviriler için bulut sunucularımızla sürekli iletişim halinde olması gerekir."
  },
  {
    id: "04",
    q: "Kütüphaneye yeni oyunlar ne sıklıkla ekleniyor?",
    a: "Sistemimiz yeni çıkan oyunları otonom olarak tarar. AAA (Büyük bütçeli) oyunlar çıktığı gün, diğer oyunlar ise topluluk taleplerine göre 24 ila 48 saat içerisinde yapay zeka tarafından işlenerek kütüphaneye dahil edilir."
  }
];
---

<section id="sss" class="faq-section">
  <div class="cyber-grid"></div>

  <div class="faq-container ai-fade-up">
    
    <div class="section-header">
      <h2 class="section-title">
        Sistem <span class="metallic-text" data-text="Veritabanı.">Veritabanı.</span>
      </h2>
      <p class="section-subtitle">
        MakineAI motorunun işleyişi hakkında merak edilenleri veri tabanımızdan sorgulayın.
      </p>
    </div>

    <div class="faq-interface">
      
      <div class="query-list">
        <div class="list-header">
          <span class="pulse-dot"></span> BEKLEYEN SORGULAR
        </div>
        <div class="queries">
          {faqs.map((faq, index) => (
            <button class={`query-btn ${index === 0 ? 'active' : ''}`} data-answer={faq.a}>
              <span class="q-id">Q_{faq.id}</span>
              <span class="q-text">{faq.q}</span>
              <div class="active-indicator"></div>
            </button>
          ))}
        </div>
      </div>

      <div class="answer-terminal">
        <div class="terminal-top">
          <div class="t-dots"><span></span><span></span><span></span></div>
          <div class="t-status">AĞ BAĞLANTISI: <span class="cyan">STABİL</span></div>
        </div>
        
        <div class="terminal-display">
          <div class="ai-response-wrapper">
            <span class="sys-tag">[MakineAI_Core] >_ </span>
            <span id="typewriter-output" class="typewriter-text">Sorgu seçiliyor...</span>
            <span class="cursor"></span>
          </div>
        </div>
        
        <div class="terminal-footer">
          <div class="barcode"></div>
          <div class="hex-data">0x00A1 0x1B8F 0x9C22</div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .faq-section {
    position: relative; padding: 120px 20px 160px;
    background: #050507; z-index: 10; overflow: hidden;
  }

  .cyber-grid {
    position: absolute; inset: 0; z-index: 0;
    background-size: 50px 50px;
    background-image: linear-gradient(to right, rgba(255, 255, 255, 0.01) 1px, transparent 1px),
                      linear-gradient(to bottom, rgba(255, 255, 255, 0.01) 1px, transparent 1px);
    mask-image: radial-gradient(circle at center, black 10%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at center, black 10%, transparent 80%);
  }

  .faq-container { max-width: 1100px; margin: 0 auto; position: relative; z-index: 2; }

  /* Başlıklar */
  .section-header { margin-bottom: 4rem; text-align: left; }
  .section-title { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; color: #fff; letter-spacing: -0.04em; margin-bottom: 1rem; }
  .metallic-text { position: relative; display: inline-block; color: #a1a1aa; }
  .metallic-text::after { content: attr(data-text); position: absolute; left: 0; top: 0; background: linear-gradient(110deg, transparent 20%, #fff 40%, #fff 60%, transparent 80%); background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: metallicShine 4s linear infinite; }
  .section-subtitle { font-size: 1.1rem; color: #71717a; max-width: 500px; line-height: 1.6; }

  /* Veritabanı Arayüzü (Ana Kutu) */
  .faq-interface {
    display: flex; gap: 2rem; align-items: stretch;
    background: rgba(13, 13, 17, 0.5); border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 24px; padding: 1.5rem; backdrop-filter: blur(20px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    min-height: 450px;
  }

  /* SOL: Sorgu Listesi */
  .query-list { flex: 1; display: flex; flex-direction: column; }
  
  .list-header { 
    display: flex; align-items: center; gap: 10px; font-family: 'SF Mono', monospace; 
    font-size: 0.8rem; color: #71717a; margin-bottom: 1.5rem; padding-left: 10px;
    letter-spacing: 0.05em;
  }
  .pulse-dot { width: 8px; height: 8px; background: #d4a843; border-radius: 50%; box-shadow: 0 0 10px #d4a843; animation: pulse 2s infinite; }

  .queries { display: flex; flex-direction: column; gap: 8px; }
  
  .query-btn {
    position: relative; width: 100%; text-align: left; background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.03); border-radius: 12px; padding: 16px 20px;
    color: #a1a1aa; cursor: pointer; transition: all 0.3s ease;
    display: flex; align-items: flex-start; gap: 12px; overflow: hidden;
  }
  .query-btn:hover { background: rgba(255,255,255,0.05); color: #fff; transform: translateX(5px); }
  
  .q-id { font-family: 'SF Mono', monospace; font-size: 0.75rem; color: #4ecdc4; margin-top: 2px; }
  .q-text { font-size: 1rem; font-weight: 500; line-height: 1.4; }
  
  /* Aktif Soru Belirteci */
  .active-indicator {
    position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
    background: #4ecdc4; box-shadow: 0 0 15px #4ecdc4;
    opacity: 0; transition: opacity 0.3s;
  }
  .query-btn.active { background: rgba(78, 205, 196, 0.08); border-color: rgba(78, 205, 196, 0.2); color: #fff; transform: translateX(5px); }
  .query-btn.active .active-indicator { opacity: 1; }

  /* SAĞ: Cevap Terminali */
  .answer-terminal {
    flex: 1.5; background: #000; border: 1px solid #27272a; border-radius: 16px;
    display: flex; flex-direction: column; overflow: hidden; position: relative;
  }
  
  .terminal-top {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 20px; background: #09090b; border-bottom: 1px solid #27272a;
  }
  .t-dots { display: flex; gap: 6px; }
  .t-dots span { width: 10px; height: 10px; border-radius: 50%; background: #3f3f46; }
  .t-dots span:nth-child(1) { background: #ff5f56; } .t-dots span:nth-child(2) { background: #ffbd2e; } .t-dots span:nth-child(3) { background: #27c93f; }
  .t-status { font-family: 'SF Mono', monospace; font-size: 0.7rem; color: #71717a; }
  .cyan { color: #4ecdc4; }

  .terminal-display {
    flex: 1; padding: 2.5rem; display: flex; align-items: flex-start;
  }
  
  .ai-response-wrapper {
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 0.95rem; line-height: 1.8; color: #e4e4e7;
  }
  .sys-tag { color: #d4a843; font-weight: 600; margin-right: 8px; }
  .cursor {
    display: inline-block; width: 8px; height: 16px; background: #4ecdc4;
    vertical-align: middle; margin-left: 4px; animation: blinkCursor 1s step-end infinite;
  }

  /* Scramble (Çözülme) Efekti Sınıfı */
  .scrambled { color: #4ecdc4; opacity: 0.8; }

  .terminal-footer {
    padding: 12px 20px; background: #09090b; border-top: 1px solid #27272a;
    display: flex; justify-content: space-between; align-items: center;
  }
  .barcode {
    width: 60px; height: 15px;
    background: repeating-linear-gradient(to right, #3f3f46, #3f3f46 2px, transparent 2px, transparent 4px, #3f3f46 4px, #3f3f46 5px, transparent 5px, transparent 8px);
    opacity: 0.5;
  }
  .hex-data { font-family: monospace; font-size: 0.7rem; color: #3f3f46; }

  /* Animasyonlar */
  @keyframes metallicShine { 0% { background-position: 200% 50%; } 100% { background-position: -200% 50%; } }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
  @keyframes blinkCursor { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
  .ai-fade-up { opacity: 0; transform: translateY(30px); animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

  /* Mobil Uyumluluk */
  @media (max-width: 992px) {
    .faq-interface { flex-direction: column; }
    .answer-terminal { min-height: 350px; }
    .section-header { text-align: center; }
    .section-subtitle { margin: 0 auto; }
  }
</style>

<script>
  // --- Mükemmel Daktilo (Typewriter) ve Şifre Çözücü Efekti ---
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.query-btn');
    const outputElement = document.getElementById('typewriter-output');
    
    // Varsayılan yazıyı al (İlk sorunun cevabı)
    const firstAnswer = buttons[0]?.getAttribute('data-answer') || '';
    
    let typingInterval: any;

    // Metni daktilo gibi yazan fonksiyon
    const typeWriter = (text: string, element: HTMLElement) => {
      clearInterval(typingInterval);
      element.innerHTML = ''; // Önceki metni temizle
      
      let i = 0;
      
      // Çok kısa bir hacker şifre çözme efekti (Glitch)
      const chars = '!<>-_\\/[]{}—=+*^?#_';
      let scrambleCycles = 0;
      
      const scrambleInterval = setInterval(() => {
        let gibberish = '';
        for(let j=0; j<15; j++) {
          gibberish += chars[Math.floor(Math.random() * chars.length)];
        }
        element.innerHTML = `<span class="scrambled">${gibberish}</span>`;
        scrambleCycles++;
        
        // 5 döngüden sonra asıl metni yazmaya başla
        if(scrambleCycles > 5) {
          clearInterval(scrambleInterval);
          element.innerHTML = '';
          
          typingInterval = setInterval(() => {
            if (i < text.length) {
              // Metni harf harf ekle
              element.innerHTML += text.charAt(i);
              i++;
            } else {
              clearInterval(typingInterval);
            }
          }, 15); // Yazı hızı (Ms)
        }
      }, 30);
    };

    // Sayfa yüklendiğinde ilk cevabı ekrana yaz
    if(outputElement) {
      typeWriter(firstAnswer, outputElement);
    }

    // Buton tıklama olayları
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Zaten aktifse tekrar çalıştırma
        if(btn.classList.contains('active')) return;

        // Tüm aktiflikleri kaldır
        buttons.forEach(b => b.classList.remove('active'));
        
        // Tıklananı aktif yap
        btn.classList.add('active');
        
        // Cevabı al ve yazdır
        const answer = btn.getAttribute('data-answer');
        if (answer && outputElement) {
          typeWriter(answer, outputElement);
        }
      });
    });
  });
</script>